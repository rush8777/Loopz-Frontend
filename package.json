{
  "name": "movcues-frontend",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:dashboard",
    "build": "npm run build:dashboard",
    "test": "npm run test:dashboard",
    "lint": "npm run lint:dashboard",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:dashboard": "npm run dev --workspace=@movcues/dashboard",
    "dev:website": "npm run dev --workspace=@movcues/website",
    "build:dashboard": "npm run build --workspace=@movcues/dashboard",
    "build:website": "npm run build --workspace=@movcues/website",
    "check:website": "npm run check --workspace=@movcues/website",
    "test:dashboard": "npm run test --workspace=@movcues/dashboard",
    "lint:dashboard": "npm run lint --workspace=@movcues/dashboard"
  }
}
