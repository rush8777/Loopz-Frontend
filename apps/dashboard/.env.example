# Backend URL used by the deployed dashboard.
VITE_API_URL=https://api.movcues.com

# Optional URL for the SDK Theme Studio preview bundle. Local development normally uses
# the built artifact in a sibling Loopz checkout. Set this for a separately served SDK.
# VITE_THEME_PREVIEW_URL=http://localhost:4179/dist/sdk-theme-preview.min.js

# Public Paddle.js token. This is intentionally safe to expose in browser code;
# never put PADDLE_API_KEY in this file or any frontend build variable.
VITE_PADDLE_CLIENT_TOKEN=live_your_paddle_client_token
