---
import SeoHead from "../components/layout/SeoHead.astro";
import WaitlistModal from "../components/marketing/WaitlistModal.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#fcfcfc" />
    <SeoHead {...Astro.props} />
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-2KM8ZQB6G1"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-2KM8ZQB6G1');

      document.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        const link = target.closest('a');
        if (!link) return;

        const href = link.href;
        const eventName = href.startsWith('https://dash.movcues.com/login')
          ? 'login_click'
          : href.startsWith('https://dash.movcues.com/signup')
            ? 'get_started_click'
            : null;
        if (!eventName) return;

        gtag('event', eventName, {
          link_text: link.textContent?.trim() || undefined,
          link_url: href,
        });
      });
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <slot />
    <WaitlistModal />
  </body>
</html>
