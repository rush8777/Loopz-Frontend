---
import MarketingLayout from "../components/marketing/MarketingLayout.astro";

const apiUrl = (import.meta.env.PUBLIC_API_URL ?? "https://api.movcues.com").replace(/\/$/, "");
---

<MarketingLayout
  title="Contact Movcues — We're here to help"
  description="Get in touch with Movcues about product questions, integrations, billing, or feedback. Send us a message and we'll get back to you."
  canonicalPath="/contact"
>
  <section class="contact-section" aria-labelledby="contact-heading">
    <div class="contact-inner section-shell">
      <div class="contact-intro" data-reveal>
        <p class="section-kicker"><span></span>Contact us</p>
        <h1 id="contact-heading">Let's talk<span class="contact-period">.</span></h1>
        <p class="contact-lead">Questions, feedback, or something you're working on? We'd love to hear from you.</p>

        <div class="contact-context">
          <div class="contact-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.55" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="3"></rect><path d="m4.5 7 7.5 6 7.5-6"></path></svg>
          </div>
          <div>
            <h2>A direct line to Movcues</h2>
            <p>Whether you're exploring the product, need a hand, or have an idea to share, this is the right place.</p>
          </div>
        </div>
        <p class="contact-caption">A little context helps us give you a more useful reply.</p>
      </div>

      <div class="contact-card" data-reveal>
        <div class="contact-card-header">
          <div>
            <p class="contact-overline">DROP US A NOTE</p>
            <h2>Send us a message</h2>
            <p>Fill out the form below and we'll reply by email.</p>
          </div>
          <span class="contact-card-mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round"><path d="m4 12.5 6 6L20 5.5"></path></svg>
          </span>
        </div>

        <form
          class="contact-form"
          data-contact-form
          data-endpoint={`${apiUrl}/public/contact`}
          data-private
          data-analytics-ignore
          autocomplete="on"
        >
          <div class="contact-field">
            <label for="contact-name">Your name <span aria-hidden="true">*</span></label>
            <input id="contact-name" name="name" type="text" placeholder="How should we call you?" autocomplete="name" minlength="2" maxlength="120" required />
          </div>
          <div class="contact-field">
            <label for="contact-email">Email address <span aria-hidden="true">*</span></label>
            <input id="contact-email" name="email" type="email" placeholder="you@company.com" autocomplete="email" maxlength="254" required />
          </div>
          <div class="contact-field">
            <label for="contact-message">Your message <span aria-hidden="true">*</span></label>
            <textarea id="contact-message" name="message" rows="5" placeholder="Tell us a little about what you need..." minlength="10" maxlength="4000" required></textarea>
          </div>

          <div class="contact-honeypot" aria-hidden="true">
            <label for="contact-website">Leave this field blank</label>
            <input id="contact-website" type="text" name="website" tabindex="-1" autocomplete="off" />
          </div>

          <p class="contact-privacy">We'll use your details only to respond to your message. See our <a href="/privacy">Privacy Policy</a>.</p>
          <p class="contact-status" data-form-status role="status" aria-live="polite"></p>
          <button class="contact-submit" type="submit" data-submit>
            <span data-button-label>Send message</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"></path></svg>
          </button>
        </form>
      </div>
    </div>
  </section>
</MarketingLayout>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-contact-form]");
  if (form) {
    const button = form.querySelector<HTMLButtonElement>("[data-submit]");
    const label = form.querySelector<HTMLElement>("[data-button-label]");
    const status = form.querySelector<HTMLElement>("[data-form-status]");

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!form.reportValidity() || !button || !label || !status || button.disabled) return;

      button.disabled = true;
      label.textContent = "Sending...";
      status.textContent = "";
      status.removeAttribute("data-state");

      const values = new FormData(form);
      try {
        const controller = new AbortController();
        const timeout = setTimeout(() => controller.abort(), 12000);
        let response: Response;
        try {
          response = await fetch(form.dataset.endpoint ?? "", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              name: String(values.get("name") ?? "").trim(),
              email: String(values.get("email") ?? "").trim(),
              message: String(values.get("message") ?? "").trim(),
              website: String(values.get("website") ?? ""),
            }),
            signal: controller.signal,
          });
        } finally {
          clearTimeout(timeout);
        }
        if (!response.ok) throw new Error("contact_delivery_failed");

        form.reset();
        status.dataset.state = "success";
        status.textContent = "Your message has been sent. Thanks for reaching out!";
      } catch {
        status.dataset.state = "error";
        status.textContent = "We couldn't send that message. Please try again shortly.";
      } finally {
        button.disabled = false;
        label.textContent = "Send message";
      }
    });
  }
</script>

<style>
  .contact-section { position: relative; min-height: 82vh; padding: clamp(9rem, 14vw, 12rem) 0 clamp(5rem, 9vw, 8rem); overflow: hidden; }
  .contact-section::before { position: absolute; inset: -6rem 0 auto; height: 39rem; pointer-events: none; background: radial-gradient(ellipse at 56% 10%, rgba(111, 142, 232, .12), transparent 62%); content: ""; }
  .contact-inner { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) minmax(21rem, .92fr); align-items: start; gap: clamp(2.5rem, 7vw, 8.5rem); }
  .contact-intro { padding-top: clamp(.5rem, 3vw, 2.25rem); max-width: 32rem; }
  .contact-intro h1 { margin: 1.15rem 0 0; font-size: clamp(4rem, 8vw, 7.4rem); line-height: .94; font-weight: 500; letter-spacing: -.085em; }
  .contact-period { color: var(--primary); }
  .contact-lead { max-width: 29rem; margin: 1.65rem 0 0; color: var(--text-secondary); font-size: clamp(1.04rem, 1.5vw, 1.22rem); line-height: 1.7; }
  .contact-context { display: flex; align-items: flex-start; gap: 1rem; margin-top: clamp(3rem, 6vw, 5.5rem); }
  .contact-icon { display: grid; flex: none; place-items: center; width: 3rem; height: 3rem; border: 1px solid #dce5ff; border-radius: .85rem; color: var(--primary); background: #eff3ff; }
  .contact-icon svg { width: 1.3rem; height: 1.3rem; }
  .contact-context h2 { margin: .05rem 0 .4rem; font-size: 1.02rem; font-weight: 650; letter-spacing: -.025em; }
  .contact-context p { max-width: 24rem; margin: 0; color: var(--text-secondary); font-size: .86rem; line-height: 1.7; }
  .contact-caption { margin: 2rem 0 0 4rem; color: var(--text-muted); font-size: .76rem; }
  .contact-card { padding: clamp(1.4rem, 3vw, 2.35rem); border: 1px solid #e0e3e9; border-radius: 1.35rem; background: #fff; box-shadow: 0 18px 64px rgba(27, 38, 70, .065), 0 2px 7px rgba(20, 28, 50, .02); }
  .contact-card-header { display: flex; justify-content: space-between; gap: 1rem; padding-bottom: 1.65rem; border-bottom: 1px solid var(--border); }
  .contact-overline { margin: 0 0 .65rem; color: #4e70bd; font-size: .7rem; font-weight: 750; letter-spacing: .11em; }
  .contact-card h2 { margin: 0; font-size: clamp(1.4rem, 2.5vw, 1.8rem); line-height: 1.2; font-weight: 600; letter-spacing: -.045em; }
  .contact-card-header p:last-child { margin: .6rem 0 0; color: var(--text-secondary); font-size: .84rem; }
  .contact-card-mark { display: grid; flex: none; place-items: center; width: 2.35rem; height: 2.35rem; border-radius: 50%; color: #3156c8; background: #eef2ff; }
  .contact-card-mark svg { width: 1.05rem; height: 1.05rem; }
  .contact-form { display: grid; gap: 1.2rem; padding-top: 1.65rem; }
  .contact-field { display: grid; gap: .52rem; }
  .contact-field label { color: var(--foreground); font-size: .82rem; font-weight: 650; }
  .contact-field label span { color: #3156c8; }
  .contact-field input, .contact-field textarea { display: block; width: 100%; min-width: 0; padding: .86rem 1rem; border: 1px solid #e1e4eb; border-radius: .68rem; outline: none; background: #fbfcfe; color: var(--foreground); font: inherit; font-size: .86rem; line-height: 1.5; transition: border-color 160ms, background 160ms, box-shadow 160ms; }
  .contact-field input::placeholder, .contact-field textarea::placeholder { color: #969daa; }
  .contact-field input:hover, .contact-field textarea:hover { border-color: #c9d0df; }
  .contact-field input:focus-visible, .contact-field textarea:focus-visible { border-color: #7794e7; background: #fff; box-shadow: 0 0 0 3px rgba(78, 112, 189, .1); }
  .contact-field textarea { min-height: 8.5rem; resize: vertical; }
  .contact-privacy { margin: -.2rem 0 0; color: var(--text-muted); font-size: .75rem; line-height: 1.65; }
  .contact-privacy a { color: var(--primary); text-decoration: underline; text-underline-offset: .2em; }
  .contact-honeypot { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .contact-status { margin: -.3rem 0 0; font-size: .79rem; line-height: 1.45; }
  .contact-status:empty { display: none; }
  .contact-status[data-state="success"] { color: #1c774d; }
  .contact-status[data-state="error"] { color: #a83e44; }
  .contact-submit { display: inline-flex; align-items: center; justify-content: center; gap: .9rem; width: 100%; min-height: 3.15rem; padding: .85rem 1.2rem; border: 1px solid #202020; border-radius: .7rem; background: #202020; color: #fff; cursor: pointer; font: inherit; font-size: .88rem; font-weight: 650; transition: background 150ms, transform 150ms; }
  .contact-submit svg { width: 1rem; height: 1rem; }
  .contact-submit:hover:not(:disabled) { background: #343434; }
  .contact-submit:active:not(:disabled) { transform: translateY(1px); }
  .contact-submit:disabled { opacity: .65; cursor: progress; }
  @media (max-width: 850px) { .contact-inner { grid-template-columns: 1fr; gap: 2.5rem; } .contact-intro { max-width: 42rem; } .contact-section { padding-top: 9rem; } .contact-context { margin-top: 2.75rem; } .contact-caption { margin-top: 1rem; } .contact-card { max-width: 42rem; width: 100%; } }
  @media (max-width: 480px) { .contact-section { padding-top: 8.25rem; } .contact-intro h1 { font-size: clamp(3.8rem, 16vw, 5.6rem); } .contact-context { gap: .8rem; } .contact-caption { margin-left: 0; } }
  @media (prefers-reduced-motion: reduce) { .contact-submit, .contact-field input, .contact-field textarea { transition: none; } }
</style>
