---
import MarketingLayout from "../../components/marketing/MarketingLayout.astro";
import PageHero from "../../components/marketing/PageHero.astro";
import ResourceGrid from "../../components/marketing/ResourceGrid.astro";
import RelatedLinks from "../../components/marketing/RelatedLinks.astro";
import { articles } from "../../data/resources";
---
<MarketingLayout title="Movcues blog | Practical product experience notes" description="Articles about onboarding, product adoption, segmentation, funnel analysis, research, and contextual experiences." canonicalPath="/resources/blog">
  <PageHero eyebrow="The Movcues blog" title="Notes for teams shaping the product journey." description="Short, practical thinking about understanding user behavior and responding with experiences that help." compact />
  <ResourceGrid eyebrow="Editorial previews" title="A small library, deliberately." description="These entries establish the content architecture while the first full articles are prepared." entries={articles} featured />
  <RelatedLinks title="Go deeper" links={[{ label: "Guides", description: "Long-form learning around core product journeys.", href: "/resources/guides" }, { label: "Templates", description: "Reusable experience starting points.", href: "/resources/templates" }, { label: "Analytics", description: "See how Movcues connects insight to action.", href: "/explore/analytics" }]} />
</MarketingLayout>
