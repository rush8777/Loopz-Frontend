---
import BaseLayout from "../layouts/BaseLayout.astro";
import LandingNavbar from "../components/layout/LandingNavbar.astro";
import Hero from "../components/landing/Hero.astro";
import Advice from "../components/landing/Advice.astro";
import Adoption from "../components/landing/Adoption.astro";
import ProductStory from "../components/landing/ProductStory.astro";
import PlatformOverview from "../components/landing/PlatformOverview.astro";
import FinalCta from "../components/landing/FinalCta.astro";
import SiteFooter from "../components/layout/SiteFooter.astro";
---

<BaseLayout>
  <Fragment slot="head">
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-2KM8ZQB6G1"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-2KM8ZQB6G1');
    </script>
  </Fragment>
  <LandingNavbar />
  <main id="main-content">
    <Hero />
    <Advice />
    <Adoption />
    <ProductStory />
    <PlatformOverview />
    <FinalCta />
  </main>
  <SiteFooter />
</BaseLayout>
