    <div class="footer-brand"><a href="/" aria-label="Movcues home"><img src={logo.src} width="140" height="26" alt="Movcues" /></a><p>Turn user behavior into action.</p></div>
    <div class="footer-column"><h2>Product</h2><a href="/product/guide">Guides</a><a href="/product/modals">Modals</a><a href="/product/checklists">Checklists</a><a href="/product/tooltips">Tooltips</a><a href="/product/dashboards">Dashboards</a></div>
