---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption: string;
}

const { src, alt, caption } = Astro.props;
const widths = [...new Set([480, 720, 1080, src.width].filter((width) => width <= src.width))].sort((a, b) => a - b);
---

<figure class="doc-screenshot">
  <a href={src.src} aria-label={`Open full-size screenshot: ${alt}`}>
    <Image
      src={src}
      alt={alt}
      widths={widths}
      sizes={`(max-width: 50rem) calc(100vw - 2rem), ${Math.min(src.width, 768)}px`}
      format="webp"
      quality={92}
      loading="lazy"
      decoding="async"
    />
  </a>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .doc-screenshot { margin: 1.75rem 0; }
  .doc-screenshot a { display: block; width: fit-content; max-width: 100%; margin-inline: auto; border: 1px solid var(--sl-color-gray-5); border-radius: 10px; overflow: hidden; background: #fff; }
  .doc-screenshot a:focus-visible { outline: 3px solid var(--sl-color-accent); outline-offset: 4px; }
  .doc-screenshot img { display: block; max-width: 100%; height: auto; margin: 0; }
  .doc-screenshot figcaption { margin-top: 0.65rem; color: var(--sl-color-gray-2); font-size: 0.875rem; line-height: 1.5; text-align: center; }
</style>
