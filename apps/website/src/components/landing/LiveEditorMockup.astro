  .le-ai-empty {display:flex;flex-direction:column;align-items:center;justify-content:center;gap:13px;min-height:0;flex:1;padding:8px}.le-ai-zap {width:48px;height:48px;display:grid;place-items:center;border-radius:16px;border:1px solid #d4e2ff;background:#e8efff;color:#3972ff;box-shadow:0 9px 21px #3168d715}.le-ai-empty p {max-width:174px;margin:0;text-align:center;font-size:10px;line-height:1.5;color:#8798b1}.le-ai-done {display:flex;align-items:center;gap:5px;padding:6px 7px;border-radius:6px;border:1px solid #baf0d6;background:#effdf5;color:#16835c;font-weight:650;font-size:8px;opacity:0}
  .le-ai-prompt {min-height:92px;flex:none;margin:0 10px 10px;padding:12px 11px 9px;border-radius:13px;border:1px solid #fff;background:linear-gradient(135deg,#fff,#f2f5fc);box-shadow:0 8px 22px #7086b322}.le-ai-prompt p {min-height:40px;margin:0;color:#667c9d;font-size:9px;line-height:1.6}.le-ai-prompt>div {display:flex;align-items:center;justify-content:space-between;gap:6px}.le-ai-prompt>div>span:first-child {display:flex;align-items:center;gap:4px;color:#8a9ab1;font-size:8px;white-space:nowrap}.le-ai-send {display:grid;place-items:center;width:26px;height:26px;flex:none;background:#356ef9;color:white;border-radius:7px;box-shadow:0 2px 6px #3874f754}
  .le-toolbar {position:absolute;z-index:4;top:8px;left:36.5%;width:42%;overflow:hidden;border-radius:13px;border:1px solid #e4e9f3;background:#f7f9ff;box-shadow:0 12px 27px #1e293b1c}.le-toolbar-top {display:flex;justify-content:space-between;align-items:center;gap:4px;padding:9px 10px 7px;background:#fbfcff;border-bottom:1px solid #e1e7f2}.le-toolbar-top strong {display:block;color:#23304a;font-size:9px;white-space:nowrap;line-height:1.2}.le-toolbar-top small {display:flex;gap:4px;align-items:center;margin-top:4px;color:#8695ad;font-size:8px;white-space:nowrap}.le-toolbar-top i {height:6px;width:6px;border-radius:50%;background:#10aa63}.le-top-icons {display:flex;align-items:center;gap:8px;color:#8ea1bc;font-size:9px}.le-top-icons svg {flex:none}
  .le-selected {position:absolute;z-index:6;right:7px;bottom:11px;width:31%;border:2px solid #3475ff;box-shadow:0 15px 33px #17233b25;background:#fff}.le-selected-tools {display:flex;align-items:center;gap:7px;position:absolute;right:0;bottom:calc(100% + 7px);padding:7px 9px;border-radius:8px;border:1px solid #e1e7ef;background:#fff;color:#56657b;box-shadow:0 7px 16px #17233b23}.le-selected-tools svg {flex:none}.le-handle {position:absolute;z-index:2;display:grid;place-items:center;height:21px;width:21px;background:#fff;border:1px solid #8abbff;border-radius:50%;color:#3977ff;box-shadow:0 2px 6px #4478d63a}.le-handle.top {left:50%;top:-11px;transform:translateX(-50%)}.le-handle.left {left:-11px;top:50%;transform:translateY(-50%)}.le-handle.right {right:-11px;top:50%;transform:translateY(-50%)}.le-handle.bottom {left:50%;bottom:-11px;transform:translateX(-50%)}
  .le-checklist {min-height:263px;padding:16px 15px 11px;background:white}.le-checklist>strong {display:block;color:#172238;line-height:1.25;font-size:14px;letter-spacing:-.04em}.le-checklist>p {margin:9px 0;color:#8090a7;font-size:10px;line-height:1.55}.le-count {color:#7c8ba2;font-size:9px}.le-progress {display:flex;justify-content:space-between;gap:3px;margin:11px 0 16px}.le-progress i {width:4px;height:4px;border-radius:50%;background:#148a50}.le-checklist ul {display:grid;gap:17px;margin:0;padding:0;list-style:none}.le-checklist li {display:flex;gap:10px;align-items:flex-start}.le-task-box {display:block;height:13px;width:13px;flex:none;margin-top:2px;background:#e3ebe5}.le-checklist li b {display:block;color:#293750;font-size:10px;line-height:1.4}.le-checklist li small {display:block;margin-top:3px;color:#8393ab;font-size:9px;line-height:1.4}.le-check-actions {display:flex;justify-content:flex-end;gap:6px;margin-top:17px}.le-check-actions>span {display:grid;place-items:center;width:25px;height:25px;background:#f8fafc;color:#5f6f86;border-radius:6px}
  .le-scene.is-playing .le-ai-prompt p {animation:le-type 1.9s steps(36,end) .25s both}.le-scene.is-playing .le-ai-done {animation:le-result .4s ease 2.35s both}.le-scene.is-playing .le-selected {animation:le-check-in .55s cubic-bezier(.18,.8,.2,1) 2.7s both}.le-scene.is-playing .le-selected-tools {animation:le-result .4s ease 3.15s both}.le-scene.is-playing .le-bar {animation:le-chart-grow .65s ease both;animation-delay:calc(.15s + var(--i) * .09s);transform-origin:bottom}
  @keyframes le-type {from{clip-path:inset(0 100% 0 0)}to{clip-path:inset(0 0 0 0)}}@keyframes le-result {from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:translateY(0)}}@keyframes le-check-in {from{opacity:0;transform:translateY(12px) scale(.98)}to{opacity:1;transform:translateY(0) scale(1)}}@keyframes le-chart-grow {from{transform:scaleY(.12);opacity:.2}to{transform:scaleY(1);opacity:1}}
