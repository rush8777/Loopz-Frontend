---
import { ArrowUp, ArrowUpRight, Bell, Check, ChevronDown, Copy, GripVertical, LayoutTemplate, Minus, Plus, Redo2, Search, Sparkles, Undo2, X, Zap } from "lucide-astro";
const metrics = [
  ["Active users", "24,892", "+18.4%"],
  ["New sign-ups", "3,248", "+12.8%"],
  ["Conversion rate", "12.6%", "+4.2%"],
  ["Avg. session", "4m 32s", "+9.1%"]
] as const;
const bars = [42, 59, 49, 72, 65, 88, 100];
const events = ["Activated", "user_signed_in", "checkout_started", "feature_viewed"];
const tasks = [
  ["Connect your data", "Add a source to your workspace."],
  ["Create your first project", "Set up a real workspace for your team."],
  ["Complete the core action", "Finish one workflow from start to result."]
] as const;
---
<div class="le-scene" data-live-editor-mockup role="group" aria-label="Illustrative Movcues live visual editor with a three-step onboarding checklist over a sample analytics dashboard">
  <div class="le-site">
    <div class="le-site-nav">
      <span class="le-brand"><span class="le-brand-icon">✳</span> lumina<span class="le-brand-dot">.</span></span>
      <div class="le-site-navlinks"><span class="active">Overview</span><span>Analytics</span><span>Projects</span><span>Settings</span></div>
      <div class="le-site-actions"><Search size={12} aria-hidden="true"/><Bell size={12} aria-hidden="true"/><span class="le-avatar">AM</span></div>
      <span class="le-back-home">Back home <ArrowUpRight size={11} aria-hidden="true"/></span>
    </div>
    <div class="le-site-content">
      <div class="le-intro"><div><span>Workspace / Overview</span><h4>Good morning, Alex.</h4><p>Here's what happened across your product this week.</p></div><span class="le-feature-cta">View features ↗</span></div>
      <div class="le-stats">
        {metrics.map(([label, value, change]) => <div class="le-stat"><span>{label}</span><strong>{value}</strong><small>↗ {change} <em>this week</em></small></div>)}
      </div>
      <div class="le-main-panels">
        <section class="le-panel"><div class="le-panel-head"><div><h5>Weekly active users</h5><p>Activity over the last 7 days</p></div><span>This week <ChevronDown size={9}/></span></div>
          <div class="le-chart" role="img" aria-label="Sample weekly active user bar chart trending upward">
            <div class="le-gridlines"></div><div class="le-bars">{bars.map((bar, i) => <span class="le-bar" style={"height:"+bar+"%;--i:"+i}></span>)}</div>
          </div><div class="le-axis"><span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span><span>Sun</span></div>
        </section>
        <section class="le-panel le-events"><div class="le-panel-head"><div><h5>Recent events</h5><p>Latest activity in your product</p></div><span>•••</span></div><div class="le-event-list">{events.map((ev, i) => <div><span class="le-event-dot"></span><strong>{ev}</strong><small>{[2,8,21,34][i]}m ago</small></div>)}</div></section>
      </div>
    </div>
  </div>
  <aside class="le-ai" aria-label="Geo-assisted visual editor preview">
    <div class="le-ai-stage">
      <div class="le-ai-empty"><span class="le-ai-zap"><Zap size={23} strokeWidth={1.9}/></span><p>Describe the change you want to make.</p></div>
      <div class="le-ai-thread" aria-label="Illustrative Geo AI design conversation">
        <div class="le-chat-user"><small>You</small><p>Create a beautiful, three-step activation checklist for new users.</p></div>
        <div class="le-chat-response"><span class="le-reply-logo"><Sparkles size={12} aria-hidden="true"/></span><div><small>Geo</small><p data-le-assistant-answer>I've created a checklist to guide new users through connecting data, starting a project, and finishing their first workflow.</p></div></div>
        <div class="le-ai-done"><Check size={11} aria-hidden="true"/> Checklist ready · 3 tasks added</div>
      </div>
    </div>
    <div class="le-ai-prompt"><p data-le-user-request>Create a beautiful, three-step activation checklist for new users.</p><span class="le-ai-placeholder" aria-hidden="true">What would you like to create?</span><div><span><Sparkles size={11} aria-hidden="true"/> Design with Movcues</span><span class="le-ai-send"><ArrowUp size={14} aria-hidden="true"/></span></div></div>
  </aside>
  <div class="le-toolbar" aria-label="Illustrative live editor status bar">
    <div class="le-toolbar-top">
      <div class="le-toolbar-label"><strong>Movcues Live Editor</strong><small><i></i> Connected · Draft saved</small></div>
      <div class="le-top-icons" aria-hidden="true"><Undo2 size={11}/><Redo2 size={11}/><span>Save</span><X size={11}/></div>
    </div>
  </div>
  <div class="le-selected" aria-label="Selected onboarding checklist in the editor">
    <div class="le-selected-tools" aria-hidden="true"><Plus size={12}/><LayoutTemplate size={12}/><span>▤</span><span>↑</span><Copy size={12}/><span>↔</span><GripVertical size={12}/><X size={12}/></div>
    <span class="le-handle top"><Plus size={12}/></span><span class="le-handle left"><Plus size={12}/></span><span class="le-handle right"><Plus size={12}/></span><span class="le-handle bottom"><Plus size={12}/></span>
    <div class="le-checklist">
      <strong>Activate your workspace</strong>
      <p>Complete these quick steps to get the most from your workspace.</p>
      <span class="le-count">0 of 3 complete</span>
      <div class="le-progress" aria-hidden="true">{Array.from({length:16},()=> <i></i>)}</div>
      <ul>{tasks.map(([title, subtitle]) => <li><span class="le-task-box"></span><div><b>{title}</b><small>{subtitle}</small></div></li>)}</ul>
      <div class="le-check-actions"><span><Minus size={11}/></span><span><X size={11}/></span></div>
    </div>
  </div>

  <!-- A passive, timed product tour. These are visuals, not interactive controls. -->
  <div class="le-tour-preview-pill" aria-hidden="true"><span></span> Previewing onboarding guide</div>

  <div class="le-tour-intro le-tour-stage" aria-hidden="true">
    <div class="le-tour-scrim"></div>
    <div class="le-tour-dialog">
      <div class="le-tour-dialog-icon"><Sparkles size={16} strokeWidth={1.8}/></div>
      <span class="le-tour-eyebrow">YOUR FIRST WORKFLOW · STEP 1 OF 3</span>
      <h5>Let's connect your data.</h5>
      <p>A few simple steps will help you get started and understand what happens in your workspace.</p>
      <div class="le-tour-dialog-actions"><span>Skip guide</span><strong>Show me how <ArrowUpRight size={11}/></strong></div>
    </div>
  </div>

  <div class="le-tour-anchored le-tour-stage" aria-hidden="true">
    <div class="le-tour-soft-shade"></div>
    <div class="le-tour-highlight"></div>
    <div class="le-tour-anchor-card">
      <span class="le-tour-eyebrow">ON THIS PAGE · STEP 2 OF 3</span>
      <h5>Watch your events arrive.</h5>
      <p>Once your source is connected, this activity feed helps you confirm that tracking is working.</p>
      <div class="le-tour-anchor-bottom"><span><i></i><i class="is-current"></i><i></i></span><strong>Continue <ArrowUpRight size={11}/></strong></div>
    </div>
  </div>

  <div class="le-tour-success le-tour-stage" aria-hidden="true">
    <div class="le-tour-scrim"></div>
    <div class="le-tour-dialog le-tour-success-dialog">
      <div class="le-tour-success-icon"><Check size={17} strokeWidth={2.25}/></div>
      <span class="le-tour-eyebrow">GUIDE COMPLETED · STEP 3 OF 3</span>
      <h5>You're ready for what's next.</h5>
      <p>You've learned where to check incoming activity. Continue setting up your workspace at your own pace.</p>
      <div class="le-tour-dialog-actions"><span>3 steps explored</span><strong>Finish guide <Check size={11}/></strong></div>
    </div>
  </div>

  <div class="le-tour-cursor" aria-hidden="true">
    <svg viewBox="0 0 24 29" width="24" height="29" fill="none">
      <path d="M2 1.5V22.5L8.2 17.1L12.7 27L17.2 24.9L12.6 15.5H22.2L2 1.5Z" fill="white" stroke="#1F2937" stroke-width="1.8" stroke-linejoin="round"/>
    </svg>
    <span class="le-tour-click-ring"></span>
  </div>
</div>
<script>
  // All copy is present in Astro's HTML before hydration, including the AI response.
  // JS only animates a visual illustration; no real editor request or analytics event fires.
  const liveMocks = document.querySelectorAll<HTMLElement>("[data-live-editor-mockup]");
  if ("IntersectionObserver" in window && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const typeText = (node: HTMLElement | null, startDelay: number, msPerCharacter: number) => {
      if (!node) return;
      const original = node.textContent ?? "";
      node.textContent = "";
      window.setTimeout(() => {
        let index = 0;
        const interval = window.setInterval(() => {
          index = Math.min(index + 1, original.length);
          node.textContent = original.slice(0, index);
          if (index >= original.length) window.clearInterval(interval);
        }, msPerCharacter);
      }, startDelay);
    };
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        const mock = entry.target as HTMLElement;
        if (mock.classList.contains("is-playing")) continue;
        mock.classList.add("is-playing");
        typeText(mock.querySelector<HTMLElement>("[data-le-user-request]"), 160, 28);
        typeText(mock.querySelector<HTMLElement>("[data-le-assistant-answer]"), 3200, 21);
        observer.unobserve(mock);
      }
    }, { threshold: 0.2 });
    liveMocks.forEach((mock) => { mock.classList.add("is-ready"); observer.observe(mock); });
  }
</script>
<style>
  .le-scene { position:relative; isolation:isolate; container-type:inline-size; overflow:hidden; width:100%; height:470px; border:1px solid #dce2ed; border-radius:15px; background:#f8fafc; color:#152137; box-shadow:0 1.5rem 3.4rem #0004; font-family:Inter,"Geist",-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif; }
  .le-scene *, .le-scene *::before, .le-scene *::after {box-sizing:border-box}
  .le-site {position:absolute;inset:0;background:#f8fafc}
  .le-site-nav {display:flex;align-items:center;gap:15px;height:47px;padding:0 15px;border-bottom:1px solid #e4e8ef;background:#fff}
