  .le-back-home {padding:9px 11px;border-radius:6px;background:#625bfa;color:#fff;white-space:nowrap;font-weight:750;font-size:9px;display:flex;align-items:center;gap:5px}
  .le-site-content {padding:50px 15px 18px}.le-intro {display:flex;justify-content:space-between;align-items:end;gap:10px;margin-left:29%;margin-bottom:21px}.le-intro>div>span {color:#8491a5;font-size:9px}.le-intro h4 {margin:7px 0 4px;font-size:22px;line-height:1.2;letter-spacing:-.055em;font-weight:790;color:#152034}.le-intro p {margin:0;color:#8a97aa;font-size:10px}.le-feature-cta {padding:9px 12px;background:#635bff;color:#fff;font-weight:750;font-size:9px;border-radius:6px;white-space:nowrap}
  .le-stats {display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:9px;margin-bottom:10px}.le-stat {min-width:0;min-height:100px;padding:15px 11px;background:#fff;border:1px solid #e4e8ee;border-radius:9px;box-shadow:0 1px 2px #0f172a08}.le-stat>span {display:block;color:#8291a5;font-size:9px}.le-stat strong {display:block;margin:11px 0 6px;color:#111d31;font-size:21px;line-height:1;letter-spacing:-.04em;font-weight:790}.le-stat small {font-size:9px;color:#0f9e70}.le-stat em {font-size:8px;color:#94a3b5;font-style:normal}
  .le-main-panels {display:grid;grid-template-columns:1.4fr 1fr;gap:10px}.le-panel {min-height:240px;min-width:0;padding:15px 14px 9px;border:1px solid #e4e8ee;background:#fff;border-radius:9px}.le-panel-head {display:flex;justify-content:space-between;gap:5px;align-items:flex-start}.le-panel-head h5 {margin:0 0 4px;font-size:12px;font-weight:760;color:#1c293e}.le-panel-head p {margin:0;font-size:8px;color:#a1acb9}.le-panel-head>span {display:flex;align-items:center;gap:4px;padding:5px;border:1px solid #e8ebf0;border-radius:5px;color:#8493a6;font-size:8px}
  .le-chart {height:153px;position:relative;margin-top:15px}.le-gridlines {position:absolute;inset:0;background:repeating-linear-gradient(to top,#ebeff5 0 1px,transparent 1px 38px)}.le-bars {position:absolute;inset:0;display:flex;align-items:end;gap:8px;padding:0 8px 0 4px}.le-bar {display:block;min-width:0;flex:1;border-radius:4px 4px 0 0;background:linear-gradient(180deg,#8e88ff,#635bfa)}.le-axis {display:flex;justify-content:space-around;margin-top:8px;color:#a5afbc;font-size:8px}
  .le-event-list {margin-top:13px}.le-event-list>div {display:flex;align-items:center;gap:7px;padding:12px 0;border-bottom:1px solid #edf0f4}.le-event-list>div:last-child {border:0}.le-event-dot {height:6px;width:6px;border-radius:50%;background:#aba4ff}.le-event-list strong {font-size:9px;color:#334157}.le-event-list small {font-size:8px;color:#a6b0be;margin-left:auto;white-space:nowrap}
  .le-ai {position:absolute;z-index:5;top:8px;left:8px;bottom:8px;width:29%;display:flex;flex-direction:column;overflow:hidden;border-radius:15px;border:1px solid #e1e9f6;background:linear-gradient(125deg,#eff5ff,#fbfcff 57%,#f1f5ff);box-shadow:0 14px 32px #0f172a26,0 0 0 3px #fff9}
  .le-ai-header {display:flex;justify-content:space-between;align-items:center;height:46px;flex:none;padding:0 11px;border-bottom:1px solid #dfe7f4}.le-ai-brand {display:flex;align-items:center;gap:6px;font-size:11px;color:#253652;letter-spacing:-.04em}.le-ai-brand>span {display:grid;place-items:center;flex:none;width:28px;height:28px;border-radius:7px;background:#336cff;color:#fff}.le-ai-header>div:last-child {display:flex;align-items:center;gap:8px;color:#7e92b0}.le-ai-tab {display:grid;place-items:center;width:28px;height:28px;border:1px solid #d9e6fc;background:#fff;border-radius:7px;color:#306bff}
