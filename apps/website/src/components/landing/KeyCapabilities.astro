---
import { ArrowUpRight, Check } from "lucide-astro";

const capabilities = [
  {
    "id": "discovery",
    "step": "Introducing Geo · AI behavioral insights",
    "activeTab": "Geo AI",
    "preview": "Geo AI behavioral insights",
    "title": "Not every user is the same. Geo knows what each one needs.",
    "description": "Geo helps you understand different types of users, spot what's holding them back, and discover better ways to turn them into customers.",
    "points": [
      "Understand user behavior and personalize groups with different needs.",
      "Discover where each group struggles and what you can do to help them convert."
    ],
    "href": "/explore/analytics",
    "link": "Discover Geo AI insights",
    "caption": "From user behavior to meaningful insights and smarter next steps, all in one place."
  },
  {
    "id": "personalize",
    "step": "Live on-site visual builder",
    "activeTab": "Live Builder",
    "preview": "on-site visual builder",
    "title": "Build the right experience, right where users need it.",
    "description": "More features mean nothing if users struggle to use them. Geo helps you create beautiful guides, tooltips, and in-app experiences right on your website, so users can adopt your product faster and with less friction.",
    "points": [
      "Create guides, modals, tooltips, and more directly on your live website.",
      "Describe what you want to Geo and let AI help you design beautiful experiences in seconds."
    ],
    "href": "/explore/experiences",
    "link": "Explore the live visual builder",
    "caption": "Build, customize, and preview in-app experiences directly on your website."
  },
  {
    "id": "analytics",
    "step": "All-in-one product analytics",
    "activeTab": "Analytics",
    "preview": "analytics dashboard and activation funnel",
    "title": "Go beyond the numbers. Understand your users.",
    "description": "Movcues goes beyond feature adoption. Use powerful dashboards, segments, and funnels to understand user behavior, uncover where they struggle, and identify the users who need your attention most, so you can take action before they leave.",
    "points": [
      "Build customizable dashboards to track the metrics that matter most.",
      "Use segments and funnels to isolate struggling users and uncover where they drop off."
    ],
    "href": "/explore/analytics",
    "link": "Explore product analytics",
    "caption": "Understand user journeys, uncover friction, and focus on the users who need your attention."
  },
  {
    "id": "feedback",
    "step": "The contextual feedback loop",
    "activeTab": "Feedback",
    "preview": "contextual in-app feedback survey",
    "title": "Don't guess what users need. Just ask them.",
    "description": "Users won't always tell you what's wrong. Movcues helps you collect feedback right inside your product, at the moments that matter, so you can understand their frustrations and improve their experience before they leave.",
    "points": [
      "Trigger contextual surveys when users struggle, drop off, or complete key actions.",
      "Collect and analyze feedback to uncover what's holding users back."
    ],
    "href": "/explore/product-feedback",
    "link": "Explore product feedback",
    "caption": "Ask the right questions at the right moment and turn user feedback into meaningful improvements."
  }
] as const;

const screenTabs = ["Geo AI", "Live Builder", "Analytics", "Feedback"] as const;
---

<section class="key-capabilities" id="key-capabilities" aria-labelledby="capabilities-title">
  <div class="section-shell">
    <header class="capabilities-intro">
      <p class="section-kicker"><span aria-hidden="true"></span>Why new users drop off</p>
      <h2 id="capabilities-title">Users signed up. <em>Why didn't they come back?</em></h2>
      <p>Most businesses know how to get users. Few know how to keep them. Movcues bridges that gap by showing where users get stuck and helping you guide them toward value, so they stay engaged and keep coming back.</p>
    </header>

    <div class="capabilities-list">
      {capabilities.map((capability, index) => (
        <article class:list={["capability-row", index % 2 === 1 && "is-reverse"]} aria-labelledby={"capability-" + capability.id}>
          <div class="capability-copy">
            <p class="capability-step">{capability.step}</p>
            <h3 id={"capability-" + capability.id}>{capability.title}</h3>
            <p class="capability-description">{capability.description}</p>
            <ul class="capability-points">
              {capability.points.map((point) => (
                <li><Check size={16} strokeWidth={2} aria-hidden="true" /><span>{point}</span></li>
              ))}
            </ul>
            <a class="capability-link" href={capability.href}>{capability.link}<ArrowUpRight size={16} aria-hidden="true" /></a>
          </div>

          <figure class="capability-figure">
            <div class="mockup-frame" role="group" aria-label={"Illustrative Movcues " + capability.preview + " interface using sample data"}>
              <div class="mockup-toolbar">
                <span class="toolbar-brand-mark" aria-hidden="true">M</span>
                <span class="toolbar-brand">movcues</span>
                <span class="toolbar-workspace">Demo workspace</span>
                <span class="toolbar-sample">Sample data</span>
              </div>
              <div class="mockup-app">
                <div class="mockup-sidebar" aria-hidden="true">
                  <span class="sidebar-label">WORKSPACE</span>
                  {screenTabs.map((tab) => (
                    <span class:list={["sidebar-item", tab === capability.activeTab && "is-active"]}>{tab}</span>
                  ))}
                </div>

                <div class="mockup-main">

                  {capability.id === "discovery" && (
                    <div class="geo-screen">
                      <div class="screen-header"><div><span class="screen-eyebrow">GEO / BEHAVIOR INTELLIGENCE</span><strong>Understand who needs help</strong></div><span class="screen-filter">Last 30 days</span></div>
                      <div class="geo-hero"><span class="ai-orb" aria-hidden="true">✦</span><div><small>GEO INSIGHT · SAMPLE</small><strong>Not all users need the same next step.</strong><p>Here are three example behavior patterns worth investigating.</p></div></div>
                      <div class="geo-cohorts">
                        <div class="geo-cohort"><span class="cohort-symbol blue">↗</span><div><b>Exploring confidently</b><small>Returning and discovering features</small></div><strong>42 <em>users</em></strong></div>
                        <div class="geo-cohort focus"><span class="cohort-symbol amber">!</span><div><b>Stuck during setup</b><small>Started onboarding, no first project</small></div><strong>34 <em>users</em></strong></div>
                        <div class="geo-cohort"><span class="cohort-symbol violet">◷</span><div><b>Quiet after signup</b><small>Haven't taken the first key action</small></div><strong>24 <em>users</em></strong></div>
                      </div>
                      <div class="geo-next"><span>✦ &nbsp; GEO RECOMMENDATION · ILLUSTRATIVE</span><p>Start by helping the setup group create their first project with a short in-app guide.</p></div>
                    </div>
                  )}

                  {capability.id === "personalize" && (
                    <div class="builder-screen">
                      <div class="screen-header"><div><span class="screen-eyebrow">LIVE BUILDER / ON-SITE EDITOR</span><strong>Edit experiences on your website</strong></div><span class="screen-filter">Draft · Preview</span></div>
                      <div class="builder-workspace">
                        <div class="builder-web">
                          <div class="builder-browser"><span class="browser-lights">● ● ●</span><span>yourapp.com / workspace</span></div>
                          <div class="builder-site">
                            <div class="site-top"><b>Acme<span>space</span></b><small>Overview　Projects　Settings</small></div>
                            <strong>Welcome to your workspace</strong><p>Organize your work, all in one place.</p>
                            <div class="site-skeleton"><i></i><i></i><i></i></div>
                            <div class="builder-spotlight"><span class="selected-chip">✦ GUIDE · SELECTED</span><small>STEP 1 OF 3</small><strong>Let's make your first project.</strong><p>Start here and see what your workspace can do.</p><span class="builder-cta">Create a project <span>↗</span></span><span class="resize-dot top-left"></span><span class="resize-dot top-right"></span><span class="resize-dot bottom-left"></span><span class="resize-dot bottom-right"></span></div>
                          </div>
                        </div>
                        <div class="builder-inspector"><div class="inspector-head"><span class="ai-orb">✦</span><div><strong>Geo AI</strong><small>Widget assistant</small></div></div><div class="inspector-message">Make this a welcoming first-project guide.</div><div class="inspector-state"><span>✓</span> One widget draft ready</div><div class="inspector-divider"></div><span class="inspector-label">ELEMENT</span><div class="inspector-property">Guide card <span>⌄</span></div><span class="inspector-label">APPEARANCE</span><div class="inspector-swatches"><i></i><i></i><i></i><i></i></div></div>
                      </div>
                      <div class="preview-footnote">Visual placement, direct editing and AI-assisted widget design · illustrative preview</div>
                    </div>
                  )}

                  {capability.id === "analytics" && (
                    <div class="analytics-screen">
                      <div class="screen-header"><div><span class="screen-eyebrow">ANALYTICS / DASHBOARDS</span><strong>Investigate your activation journey</strong></div><span class="screen-filter">Last 30 days</span></div>
                      <div class="analytics-kpis"><div><small>Users</small><strong>1,284</strong><span>Unique visitors</span></div><div><small>Activation rate</small><strong>24%</strong><span>First project created</span></div><div class="attention"><small>Needs attention</small><strong>34</strong><span>Stalled during setup</span></div></div>
                      <div class="analytics-panels">
                        <div class="analytics-funnel"><div class="panel-heading"><strong>First project activation</strong><span>FUNNEL</span></div><div class="funnel-rows"><div><span>Signed up</span><i><b style="width:100%"></b></i><strong>100</strong></div><div><span>Started setup</span><i><b style="width:58%"></b></i><strong>58</strong></div><div><span>First project</span><i><b style="width:24%"></b></i><strong>24</strong></div></div></div>
                        <div class="analytics-segment"><div class="panel-heading"><strong>Investigate segment</strong><span>SEGMENT</span></div><div class="segment-count">34 <small>users</small></div><p>Started setup, but never created a first project.</p><span class="segment-pill">◎ &nbsp; View affected users</span></div>
                      </div>
                      <div class="preview-footnote">Dashboards reveal trends. Funnels locate friction. Segments isolate users.</div>
                    </div>
                  )}

                  {capability.id === "feedback" && (
                    <div class="feedback-screen">
                      <div class="screen-header"><div><span class="screen-eyebrow">FEEDBACK / IN-APP SURVEYS</span><strong>Ask while the experience is fresh</strong></div><span class="screen-filter">Sample survey</span></div>
                      <div class="feedback-stage">
                        <div class="feedback-context"><span class="feedback-label">TARGETING RULE</span><div class="trigger-badge"><span></span> In-app behavior</div><strong>Ask users stalled in setup.</strong><p>Show a short survey to users who started onboarding but haven't created a project.</p><div class="context-divider"></div><span class="feedback-label">RIGHT MOMENT</span><div class="moment-card">↗ &nbsp; When setup is revisited</div></div>
                        <div class="feedback-card"><span class="survey-accent"></span><small>WE'D LOVE YOUR FEEDBACK</small><strong>What's stopping you from creating your first project?</strong><div class="feedback-choice"><i></i> I'm not sure where to start</div><div class="feedback-choice"><i></i> Setup feels complicated</div><div class="feedback-choice"><i></i> I'm just exploring</div><span class="survey-submit">Share feedback <span>↗</span></span><div class="survey-progress"><i></i><i></i><i></i></div></div>
                      </div>
                      <div class="feedback-insight"><span class="ai-orb">✦</span><div><small>SAMPLE FEEDBACK THEME</small><strong>“I'm not sure where to start.”</strong></div><span class="feedback-tag">Actionable insight</span></div>
                    </div>
                  )}
                </div>
              </div>
            </div>
            <figcaption><span class="caption-indicator" aria-hidden="true"></span>{capability.caption} <span class="caption-qualifier">Illustrative UI · sample data</span></figcaption>
          </figure>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .key-capabilities { --capability-accent: color-mix(in srgb, var(--primary) 45%, white); padding-block: clamp(4.5rem, 8vw, 8rem); border-block: 1px solid #303542; background: radial-gradient(ellipse at 95% 0%, color-mix(in srgb, var(--primary) 24%, transparent), transparent 38%), radial-gradient(ellipse at 0% 75%, color-mix(in srgb, var(--primary) 14%, transparent), transparent 35%), var(--dark-surface); color: #f5f6fb; }
  .key-capabilities .section-shell { width: min(1560px, calc(100% - (var(--site-gutter) * 2))); }
  .capabilities-intro { max-width: 48rem; margin-bottom: clamp(3.2rem, 6vw, 5.5rem); }
  .capabilities-intro .section-kicker { color: var(--capability-accent); }
  .capabilities-intro h2 { margin: 1.2rem 0 1rem; font-family: var(--display-serif); font-size: clamp(2.25rem, 4.2vw, 3.7rem); font-weight: 400; letter-spacing: -.045em; line-height: 1.08; text-wrap: balance; }
  .capabilities-intro h2 em { color: var(--capability-accent); font-weight: 400; }
  .capabilities-intro > p:last-child { max-width: 43rem; color: #bac2d0; font-size: 1rem; line-height: 1.7; }
  .capabilities-list { display: grid; gap: clamp(3rem, 6vw, 5.5rem); }
  .capability-row { display: grid; grid-template-columns: minmax(0, .86fr) minmax(0, 1.14fr); gap: clamp(2rem, 5vw, 5rem); align-items: center; }
  .capability-row + .capability-row { padding-top: clamp(3rem, 6vw, 5.5rem); border-top: 1px solid #343a47; }
  .capability-row.is-reverse { grid-template-columns: minmax(0, 1.14fr) minmax(0, .86fr); }
  .is-reverse .capability-copy { order: 2; }
  .capability-copy { min-width: 0; }
  .capability-step { margin: 0 0 .85rem; color: var(--capability-accent); font-size: .72rem; font-weight: 700; text-transform: uppercase; letter-spacing: .13em; }
  .capability-copy h3 { max-width: 28rem; margin: 0; font-size: clamp(1.8rem, 3vw, 2.55rem); font-weight: 500; letter-spacing: -.055em; line-height: 1.12; text-wrap: balance; }
  .capability-description { margin: 1.1rem 0 0; color: #c5ccda; font-size: .96rem; line-height: 1.75; }
  .capability-points { display: grid; gap: .75rem; margin: 1.35rem 0 1.5rem; padding: 0; list-style: none; }
  .capability-points li { display: flex; align-items: flex-start; gap: .65rem; color: #b8c2d3; font-size: .82rem; line-height: 1.6; }
  .capability-points svg { margin-top: .2rem; flex-shrink: 0; color: var(--capability-accent); }
  .capability-link { display: inline-flex; align-items: center; gap: .5rem; padding-block: .35rem; color: #e3ebff; font-size: .84rem; font-weight: 600; text-decoration: underline; text-decoration-color: #61749d; text-underline-offset: .35rem; }
  .capability-link:hover { color: #fff; text-decoration-color: currentColor; }
  .capability-link:focus-visible { outline: 3px solid var(--capability-accent); outline-offset: 5px; border-radius: .2rem; }
  .capability-figure { min-width: 0; margin: 0; }
  .mockup-frame { min-width: 0; overflow: hidden; border: 1px solid #aebfdf; border-radius: .9rem; background: #f6f8fc; color: #19233a; box-shadow: 0 1.5rem 3.3rem rgba(0, 0, 0, .25), 0 0 0 5px rgba(111, 142, 232, .06); font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
  .mockup-toolbar { display: flex; align-items: center; gap: .48rem; min-height: 2.6rem; padding: .55rem .85rem; border-bottom: 1px solid #e1e6f0; background: #fff; }
  .toolbar-brand-mark { display: grid; place-items: center; width: 1.45rem; height: 1.45rem; border-radius: .4rem; background: #3156c8; color: white; font-size: .8rem; font-weight: 800; }
  .toolbar-brand { font-size: .76rem; font-weight: 800; letter-spacing: -.035em; }
  .toolbar-workspace { margin-left: .6rem; padding-left: .7rem; border-left: 1px solid #dfe4ee; color: #6a7486; font-size: .65rem; }
  .toolbar-sample { margin-left: auto; padding: .25rem .5rem; border: 1px solid #cdd9ff; border-radius: 99px; background: #edf2ff; color: #4262b4; font-size: .58rem; font-weight: 700; white-space: nowrap; }
  .mockup-app { display: grid; grid-template-columns: 6.75rem minmax(0, 1fr); min-height: 19.7rem; }
  .mockup-sidebar { display: flex; flex-direction: column; gap: .3rem; padding: 1rem .55rem; border-right: 1px solid #e4e8ef; background: #fbfcff; }
  .sidebar-label { margin: .1rem .4rem .55rem; font-size: .48rem; font-weight: 700; letter-spacing: .12em; color: #94a0b4; }
  .sidebar-item { padding: .6rem .55rem; border-radius: .4rem; color: #778397; font-size: .61rem; font-weight: 600; }
  .sidebar-item.is-active { background: #e9f0ff; color: #254caa; }
  .mockup-main { min-width: 0; padding: 1.1rem clamp(.85rem, 2vw, 1.45rem) 1rem; }
  .screen-header { display: flex; justify-content: space-between; align-items: flex-start; gap: .65rem; margin-bottom: 1.15rem; }
  .screen-header > div { display: grid; gap: .36rem; min-width: 0; }
  .screen-eyebrow { color: #7d8aa4; font-size: .49rem; font-weight: 750; letter-spacing: .075em; }
  .screen-header strong { font-size: clamp(.88rem, 1.65vw, 1.08rem); font-weight: 750; letter-spacing: -.035em; line-height: 1.2; }
  .screen-filter { flex-shrink: 0; padding: .33rem .47rem; border: 1px solid #e0e5ef; border-radius: .35rem; background: #fff; color: #52607c; font-size: .55rem; white-space: nowrap; }
  .screen-footer { display: flex; align-items: center; gap: .4rem; margin-top: 1rem; font-size: .57rem; font-weight: 700; color: #3558ac; line-height: 1.5; }
  .screen-footer > span:last-child { font-size: .9rem; }
  .footer-dot { flex: 0 0 auto; width: .4rem; height: .4rem; border-radius: 50%; background: #3975ec; }
  .funnel-summary { padding: .75rem .9rem; border: 1px solid #d5e0fa; border-radius: .55rem; background: #edf3ff; }
  .funnel-summary > span { display: block; color: #5d75a3; font-size: .53rem; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; }
  .funnel-summary strong { display: block; margin-top: .24rem; font-size: .94rem; color: #274c9e; }
  .funnel-summary p { margin: .3rem 0 0; color: #5b6a80; font-size: .57rem; }
  .funnel-list { display: grid; gap: .67rem; margin-top: .95rem; }
  .funnel-step > div:first-child { display: flex; align-items: center; gap: .55rem; margin-bottom: .28rem; }
  .funnel-step > div:first-child span { color: #93a0b4; font-size: .55rem; }
  .funnel-step b { color: #34415a; font-size: .64rem; font-weight: 650; }
  .funnel-step strong { margin-left: auto; color: #273b64; font-size: .7rem; }
  .funnel-track { width: 100%; height: .63rem; overflow: hidden; border-radius: .2rem; background: #e9eef7; }
  .funnel-bar { display: block; height: 100%; border-radius: .2rem; background: #527bea; }
  .funnel-bar.is-first { width: 100%; } .funnel-bar.is-second { width: 58%; background: #7999ef; } .funnel-bar.is-third { width: 24%; background: #b1c5f7; }
  .segment-summary { display: flex; align-items: center; gap: .7rem; padding: .85rem; border: 1px solid #dbe4f6; border-radius: .55rem; background: #fff; }
  .segment-people { font-size: 2rem; font-weight: 800; letter-spacing: -.08em; color: #2c56bd; }
  .segment-summary > div { display: grid; gap: .2rem; }
  .segment-summary strong { font-size: .68rem; }
  .segment-summary small { color: #7e8ca3; font-size: .52rem; }
  .segment-status { display: inline-flex; align-items: center; gap: .3rem; margin-left: auto; font-size: .52rem; font-weight: 700; color: #23825e; white-space: nowrap; }
  .segment-status i, .target-dot { display: inline-block; flex: 0 0 auto; width: .42rem; height: .42rem; border-radius: 50%; background: #33aa80; }
  .segment-rule-heading { margin: 1rem 0 .5rem; color: #566580; font-size: .58rem; font-weight: 750; }
  .segment-rule { display: flex; align-items: center; gap: .55rem; min-height: 2.5rem; padding: .55rem .7rem; border: 1px solid #dfe5ef; border-radius: .48rem; background: #fff; }
  .rule-property { padding: .3rem .45rem; border-radius: .25rem; background: #ebf1ff; color: #4260a9; font-size: .56rem; }
  .segment-rule b { flex: 1; font-size: .62rem; font-weight: 650; line-height: 1.4; }
  .rule-check { color: #289b75; font-weight: 800; font-size: .7rem; }
  .segment-operator { margin: .35rem 0 .35rem .8rem; color: #8b96a9; font-size: .52rem; font-weight: 800; }
  .experience-target { display: flex; align-items: center; gap: .35rem; padding: .62rem .75rem; border: 1px solid #dce5f6; border-radius: .42rem; background: #edf2fc; color: #475c87; font-size: .58rem; }
  .experience-target strong { color: #24498d; }
  .audience-count { margin-left: auto; color: #3558a5; font-weight: 750; white-space: nowrap; }
  .checklist-preview { width: min(100%, 21rem); margin: .9rem auto 0; padding: .9rem 1rem .5rem; border: 1px solid #dce2ed; border-radius: .75rem; background: white; box-shadow: 0 .7rem 1.8rem rgba(40, 62, 110, .12); }
  .checklist-top { display: flex; align-items: flex-start; justify-content: space-between; gap: .5rem; }
  .checklist-top small { display: block; color: #6082b5; font-size: .48rem; font-weight: 800; letter-spacing: .09em; }
  .checklist-top strong { display: block; margin: .35rem 0 .2rem; font-size: .94rem; letter-spacing: -.03em; }
  .checklist-top p { margin: 0; color: #69778c; font-size: .57rem; line-height: 1.55; }
  .checklist-progress-label { padding: .28rem .45rem; border-radius: .3rem; background: #f0f5ff; font-size: .55rem; font-weight: 750; color: #5276c6; }
  .checklist-progress { height: .34rem; margin: .75rem 0 .4rem; border-radius: 99px; background: #e9eef8; }
  .checklist-progress i { width: 0; display: block; }
  .checklist-task { display: flex; align-items: center; gap: .5rem; padding: .57rem 0; border-top: 1px solid #eef1f7; }
  .checklist-task > span { flex: 0 0 auto; width: .95rem; height: .95rem; border: 1.5px solid #b5c4e0; border-radius: 50%; }
  .checklist-task b { font-size: .59rem; font-weight: 650; }
  .checklist-task em { margin-left: auto; color: #315fc0; font-size: .54rem; font-weight: 750; font-style: normal; white-space: nowrap; }
  .results-metrics { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .45rem; }
  .results-metrics > div { display: grid; gap: .3rem; padding: .65rem .55rem; border: 1px solid #dfe5ef; border-radius: .45rem; background: white; }
  .results-metrics span { color: #6a7891; font-size: .57rem; font-weight: 600; }
  .results-metrics strong { color: #293e74; font-size: 1.45rem; font-weight: 800; line-height: 1; }
  .results-metrics small { color: #9aa5b8; font-size: .51rem; }
  .results-report { margin-top: .9rem; padding: .8rem; border: 1px solid #dfe5ef; border-radius: .5rem; background: white; }
  .results-report-title { display: flex; justify-content: space-between; gap: .5rem; margin-bottom: .7rem; }
  .results-report-title strong { font-size: .65rem; }
  .results-report-title > span { color: #97a1b1; font-size: .53rem; }
  .results-line { display: grid; grid-template-columns: 3.25rem minmax(0, 1fr) 1.4rem; align-items: center; gap: .5rem; margin: .53rem 0; }
  .results-line > span { color: #6d7a91; font-size: .55rem; }
  .results-line > div { height: .55rem; border-radius: .2rem; background: #eef1f7; overflow: hidden; }
  .results-line b { color: #465b82; text-align: right; font-size: .62rem; }
  .result-bar { display: block; height: 100%; border-radius: inherit; background: #527bea; }
  .result-bar.reach { width: 100%; } .result-bar.started { width: 67.86%; background: #82a0ec; } .result-bar.completed { width: 42.86%; background: #b1c5f7; }
