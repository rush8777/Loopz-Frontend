---
import { ArrowUpRight, Check, CodeXml, MousePointer2, SlidersHorizontal, Target, TrendingUp } from "lucide-astro";

const capabilities = [
  {
    id: "sdk", label: "One simple installation", icon: CodeXml,
    title: "One snippet. A whole product toolkit.",
    description: "Add the Movcues snippet in under a minute. Start collecting page views and interactions, then use the same SDK to deliver guides, surveys, banners, and checklists—without installing a separate script for each feature.",
    points: ["Retroactive analysis: explore already-captured behavior when a new question comes up.", "Async loading, batched events, and on-demand runtimes keep the installation lightweight."],
    href: "/resources#documentation", link: "Explore SDK setup",
    caption: "Capture starts after installation. Analyze that collected history later; custom events and user identification can be added when needed.",
  },
  {
    id: "builder", label: "A visual experience builder", icon: MousePointer2,
    title: "Drag, drop, and make it yours.",
    description: "Build in-app experiences visually. Drag content blocks onto the canvas, edit the message, and adjust spacing, colors, and layout. Shape a focused guide or survey around the next step your users need to take.",
    points: ["Move between Blocks and Properties, with desktop and mobile previews.", "Use the live editor to select page elements and position contextual guidance."],
    href: "/explore/experiences", link: "Explore the experience builder",
    caption: "Illustrative editor: content blocks, a selected guide card, and visual styling controls. Configure delivery before publishing.",
  },
  {
    id: "targeting", label: "Behavioral targeting & segments", icon: Target,
    title: "The right message. Only the right users.",
    description: "Reach people who need help instead of showing the same message to everyone. Combine events, page visits, user properties, funnel progress, and survey responses into reusable audiences with nested all/any rules.",
    points: ["Turn a funnel drop-off cohort into an audience for a relevant follow-up.", "Pair your segment with page rules, triggers, frequency, and scheduling."],
    href: "/explore/targeting", link: "Explore targeting & segments",
    caption: "Illustrative segment: trial users who started setup but have not published, with a relevant page visit or funnel drop-off.",
  },
  {
    id: "results", label: "Results that inform the next move", icon: TrendingUp,
    title: "See the result. Improve the next step.",
    description: "Review who saw your experience, where users stopped, and what they said. Bring experience results together with funnels and dashboards to decide which message, audience, or product step needs attention next.",
    points: ["Inspect reach, starts, completions, dismissals, and guide step drop-off.", "Read survey responses alongside behavior to make better-informed product decisions."],
    href: "/product/dashboards", link: "Explore dashboards & results",
    caption: "Illustrative guide results: 240 of 360 viewers completed (66.7%). Explore each step to find where users need more support.",
  },
];
const snippet = '<script async src="https://cdn.movcues.com/v1.js"\n  data-site-id="YOUR_SITE_ID"></script>';
---

<section class="key-capabilities" id="key-capabilities" aria-labelledby="capabilities-title">
  <div class="section-shell">
    <header class="capabilities-intro">
      <p class="section-kicker"><span aria-hidden="true"></span>Key capabilities</p>
      <h2 id="capabilities-title">Everything to turn understanding <br />into <em>meaningful action.</em></h2>
      <p>Install once. Build the experience. Find the audience. Learn what to improve.</p>
    </header>

    <div class="capabilities-list">
      {capabilities.map((capability, index) => {
        const Icon = capability.icon;
        return (
          <article class:list={["capability-row", index % 2 === 1 && "is-reverse"]} aria-labelledby={`capability-${capability.id}`}>
            <div class="capability-copy">
              <p class="capability-label"><span class="capability-icon"><Icon size={17} strokeWidth={1.7} aria-hidden="true" /></span>{capability.label}</p>
              <h3 id={`capability-${capability.id}`}>{capability.title}</h3>
              <p class="capability-description">{capability.description}</p>
              <ul class="capability-points">{capability.points.map(point => <li><Check size={16} strokeWidth={1.8} aria-hidden="true" /><span>{point}</span></li>)}</ul>
              <a class="capability-link" href={capability.href}>{capability.link}<ArrowUpRight size={16} aria-hidden="true" /></a>
            </div>

            <figure class:list={["capability-figure", `is-${capability.id}`]}>
              <div class="mockup-frame">
                <div class="mockup-toolbar"><span class="mockup-brand" aria-hidden="true">m.</span><span>{["SDK installation", "Experience editor", "Segment builder", "Experience results"][index]}</span><span class="mockup-tag">{["One snippet", "Guide draft", "Dynamic audience", "Last 30 days"][index]}</span></div>

                {capability.id === "sdk" && <div class="sdk-demo">
                  <div class="mockup-heading"><small>01 / CONNECT YOUR WEBSITE</small><strong>Small snippet. Big possibilities.</strong></div>
                  <div class="snippet-panel"><div><span>index.html</span><span>Inside &lt;head&gt;</span></div><pre><code>{snippet}</code></pre></div>
                  <div class="sdk-ready"><span class="status-dot" aria-hidden="true"></span><span>Automatic capture starts after installation</span><Check size={15} aria-hidden="true" /></div>
                  <div class="captured-events"><div><strong>Capture now. Explore later.</strong><span>Example event stream</span></div><ul><li><span>Page view</span><code>/workspace</code><small>10:42:01</small></li><li><span>Click</span><code>Create project</code><small>10:42:08</small></li><li><span>Page view</span><code>/projects/new</code><small>10:42:09</small></li></ul></div>
                  <div class="sdk-features"><span>Analytics</span><span>Guides</span><span>Surveys</span><span>Checklists</span></div>
                </div>}

                {capability.id === "builder" && <div class="editor-demo">
                  <div class="editor-topline"><span>Welcome guide <small>· Draft</small></span><span>Desktop <span aria-hidden="true">/</span> Mobile</span></div>
                  <div class="editor-workspace">
                    <div class="editor-sidebar"><div class="editor-tabs"><b>Blocks</b><span>Properties</span></div><div class="editor-blocks">{[["T", "Heading"], ["≡", "Text"], ["▭", "Button"], ["▧", "Image"]].map(([symbol, label]) => <div><span aria-hidden="true">{symbol}</span><b>{label}</b></div>)}</div><div class="editor-style"><span><SlidersHorizontal size={13} aria-hidden="true" />Style controls</span><p>Spacing <b>24 px</b></p><p>Radius <b>12 px</b></p><p>Accent <i aria-hidden="true"></i><b>Blue</b></p></div></div>
                    <div class="editor-canvas"><div class="canvas-label">LIVE PREVIEW</div><div class="guide-preview"><div class="selection-label">Guide card</div><small>STEP 1 OF 3</small><strong>A great start, one step away.</strong><p>Create your first project and give your team a place to work.</p><div><span>Not now</span><b>Create project <span aria-hidden="true">→</span></b></div><span class="selection-handle" aria-hidden="true"></span></div><div class="canvas-footer"><span>Desktop preview</span><span>100%</span></div></div>
                  </div>
                </div>}

                {capability.id === "targeting" && <div class="target-demo">
                  <div class="mockup-heading"><small>AUDIENCE / SETUP NEEDS ATTENTION</small><strong>Help trial users finish setup</strong></div>
                  <div class="rule-group"><p>Match <b>ALL</b> of these conditions</p><div class="rule-line"><span>Property</span><b>plan</b><small>equals <strong>trial</strong></small></div><div class="rule-line"><span>Event</span><b>setup_started</b><small>has occurred</small></div><div class="rule-line"><span>Event</span><b>project_published</b><small>has not occurred</small></div><div class="nested-rules"><p>And <b>ANY</b> of these conditions</p><div class="rule-line"><span>Page</span><b>Workspace settings</b><small>was visited</small></div><div class="rule-line"><span>Funnel</span><b>Activation</b><small>dropped after setup</small></div></div></div>
                  <div class="delivery-context"><Target size={16} aria-hidden="true" /><span><strong>Setup reminder</strong><small>This audience · Workspace page · Page-load trigger</small></span><ArrowUpRight size={16} aria-hidden="true" /></div>
                </div>}

                {capability.id === "results" && <div class="results-demo">
                  <div class="mockup-heading"><small>GUIDE / FIRST PROJECT</small><strong>Understand what happened next</strong></div>
                  <dl class="result-metrics"><div><dt>Users seen</dt><dd>360</dd></div><div><dt>Completed</dt><dd>240</dd></div><div><dt>Completion rate</dt><dd>66.7<span>%</span></dd></div></dl>
                  <div class="result-funnel"><div class="results-panel-heading"><strong>Guide step performance</strong><span>Users reached</span></div>{[{label: "Welcome", count: 360, width: 100}, {label: "Create project", count: 288, width: 80}, {label: "Invite teammate", count: 240, width: 66.7}].map((step, i) => <div class="result-step"><span>0{i + 1}</span><b>{step.label}</b><div class="result-bar"><i style={`width:${step.width}%`}></i></div><strong>{step.count}</strong></div>)}</div>
                  <div class="results-insight"><TrendingUp size={17} aria-hidden="true" /><div><strong>A clearer place to investigate</strong><p>72 users did not reach “Create project.” Review that step’s message and audience before the next iteration.</p></div></div>
                </div>}
              </div>
              <figcaption>{capability.caption}</figcaption>
            </figure>
          </article>
        );
      })}
    </div>
  </div>
</section>

<style>
  .key-capabilities {
    --capability-accent: color-mix(in srgb, var(--primary) 45%, white);
    padding-block: clamp(4.5rem, 8vw, 8rem);
    border-block: 1px solid #303542;
    background:
      radial-gradient(ellipse at 95% 0%, color-mix(in srgb, var(--primary) 24%, transparent), transparent 38%),
      radial-gradient(ellipse at 0% 75%, color-mix(in srgb, var(--primary) 14%, transparent), transparent 35%),
      var(--dark-surface);
    color: #f5f6fb;
  }
  .capabilities-intro .section-kicker { color: var(--capability-accent); }
  .capabilities-intro { max-width: 48rem; margin-bottom: clamp(3rem, 6vw, 5rem); }
  .capabilities-intro h2 { margin: 1.2rem 0 1rem; font-family: var(--display-serif); font-size: clamp(2.25rem, 4.2vw, 3.7rem); font-weight: 400; letter-spacing: -.045em; line-height: 1.08; }
  .capabilities-intro h2 em { color: var(--capability-accent); font-weight: 400; }
  .capabilities-intro > p:last-child { color: #bac2d0; font-size: 1rem; }
  .capabilities-list { display: grid; gap: clamp(3rem, 6vw, 5.5rem); }
  .capability-row { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: clamp(2rem, 5vw, 5rem); align-items: center; }
  .capability-row + .capability-row { padding-top: clamp(3rem, 6vw, 5.5rem); border-top: 1px solid #343a47; }
  .capability-row.is-reverse { grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr); }
  .is-reverse .capability-copy { order: 2; }
  .capability-copy { min-width: 0; }
  .capability-label { display: flex; align-items: center; gap: .65rem; margin: 0 0 1rem; color: #c7cedb; font-size: .74rem; font-weight: 600; }
  .capability-icon { display: grid; place-items: center; width: 2rem; height: 2rem; border: 1px solid #43516d; border-radius: .55rem; background: color-mix(in srgb, var(--primary) 18%, var(--dark-surface)); color: var(--capability-accent); flex-shrink: 0; }
  .capability-copy h3 { max-width: 25rem; margin: 0; font-size: clamp(1.8rem, 3vw, 2.55rem); font-weight: 500; letter-spacing: -.055em; line-height: 1.12; text-wrap: balance; }
  .capability-description { margin: 1.15rem 0 0; color: #bac2d0; font-size: .95rem; line-height: 1.75; }
  .capability-points { display: grid; gap: .8rem; margin: 1.4rem 0 1.5rem; padding: 0; list-style: none; }
  .capability-points li { display: flex; align-items: flex-start; gap: .65rem; color: #bac2d0; font-size: .81rem; line-height: 1.65; }
  .capability-points svg { margin-top: .25rem; flex-shrink: 0; color: var(--capability-accent); }
  .capability-link { display: inline-flex; align-items: center; gap: .5rem; padding-block: .35rem; color: #d5dfff; font-size: .81rem; font-weight: 600; text-decoration: underline; text-decoration-color: #61749d; text-underline-offset: .35rem; }
  .capability-link:hover { color: white; text-decoration-color: currentColor; }
  .capability-link:focus-visible { outline: 3px solid var(--capability-accent); outline-offset: 5px; border-radius: .2rem; }
  .capability-figure { min-width: 0; margin: 0; }
  .mockup-frame { overflow: hidden; border: 1px solid #bac9ee; border-radius: .85rem; background: white; color: var(--foreground); box-shadow: 0 22px 55px -22px rgba(0, 0, 0, .65), 0 0 0 5px rgba(111, 142, 232, .07); }
  .mockup-toolbar { display: flex; align-items: center; gap: .6rem; min-height: 3.15rem; padding: .7rem 1rem; border-bottom: 1px solid #dce4f5; background: #edf2ff; font-size: .72rem; font-weight: 600; }
  .mockup-brand { display: grid; place-items: center; width: 1.6rem; height: 1.6rem; border-radius: .4rem; background: var(--primary); color: white; font-size: .95rem; }
  .mockup-tag { margin-left: auto; padding: .25rem .5rem; border: 1px solid #e3e6ed; border-radius: .35rem; color: #626a7a; background: #f8f9fb; font-size: .6rem; font-weight: 400; }
  figcaption { margin: .85rem .3rem 0; color: #aeb8ca; font-size: .68rem; line-height: 1.6; }
  .sdk-demo, .target-demo, .results-demo { padding: clamp(1rem, 2vw, 1.65rem); }
  .mockup-heading { display: grid; gap: .4rem; margin-bottom: 1.1rem; }
  .mockup-heading small { color: #616b80; font-size: .57rem; font-weight: 600; letter-spacing: .07em; }
  .mockup-heading > strong { font-size: .98rem; font-weight: 600; letter-spacing: -.025em; }
  .snippet-panel { overflow: hidden; border: 1px solid #292e3c; border-radius: .55rem; background: #1c2130; color: #e6eafa; }
  .snippet-panel > div { display: flex; justify-content: space-between; padding: .65rem .9rem; border-bottom: 1px solid #353c4f; color: #aeb9cf; font: .6rem var(--font-data); }
  pre { margin: 0; padding: 1rem .9rem; white-space: pre-wrap; overflow-wrap: anywhere; font: .7rem/1.8 var(--font-data); }
  .sdk-ready { display: flex; align-items: center; gap: .5rem; padding-block: .85rem; color: #28704c; font-size: .65rem; }
  .sdk-ready > svg { margin-left: auto; flex-shrink: 0; }
  .status-dot { width: .4rem; height: .4rem; border-radius: 50%; background: #35895e; flex-shrink: 0; }
  .captured-events { padding: .85rem; border: 1px solid #e6e8ee; border-radius: .5rem; }
  .captured-events > div { display: flex; align-items: center; justify-content: space-between; gap: .5rem; font-size: .66rem; }
  .captured-events > div > span { color: #656b76; font-size: .56rem; }
  .captured-events ul { margin: .6rem 0 0; padding: 0; list-style: none; }
  .captured-events li { display: grid; grid-template-columns: 3.8rem minmax(0, 1fr) auto; gap: .3rem; padding: .5rem 0; border-top: 1px solid #eff0f4; font-size: .6rem; }
  .captured-events code { overflow-wrap: anywhere; color: #4f5870; font-family: var(--font-data); font-size: .59rem; }
  .captured-events small { color: #656b76; font-size: .56rem; font-variant-numeric: tabular-nums; }
  .sdk-features { display: flex; flex-wrap: wrap; gap: .4rem; margin-top: .8rem; }
  .sdk-features span { padding: .25rem .5rem; border-radius: .3rem; background: #f1f4fb; color: #526488; font-size: .57rem; }
  .editor-topline { display: flex; justify-content: space-between; gap: .5rem; padding: .75rem 1rem; font-size: .64rem; }
  .editor-topline small, .editor-topline > span:last-child { color: #656b76; font-size: .58rem; }
  .editor-workspace { display: grid; grid-template-columns: 8.1rem minmax(0, 1fr); min-height: 22rem; border-top: 1px solid #e6e8ee; }
  .editor-sidebar { padding: .7rem; background: #fafbfc; border-right: 1px solid #e6e8ee; }
  .editor-tabs { display: flex; justify-content: space-between; gap: .3rem; padding: .2rem 0 .7rem; font-size: .59rem; color: #656b76; }
  .editor-tabs b { color: var(--primary); }
  .editor-blocks { display: grid; grid-template-columns: 1fr 1fr; gap: .4rem; }
  .editor-blocks > div { display: grid; justify-items: center; gap: .25rem; padding: .65rem .2rem; border: 1px solid #e1e5ed; border-radius: .35rem; background: white; }
  .editor-blocks > div > span { font-size: 1rem; color: #556b9a; }
  .editor-blocks b { font-size: .54rem; font-weight: 400; }
  .editor-style { margin-top: 1rem; padding-top: .8rem; border-top: 1px solid #e1e5ed; }
  .editor-style > span { display: flex; align-items: center; gap: .3rem; font-size: .58rem; }
  .editor-style p { display: flex; align-items: center; gap: .25rem; margin: .7rem 0 0; color: #656b76; font-size: .56rem; }
  .editor-style b { margin-left: auto; color: #333b4b; font-weight: 400; }
  .editor-style i { margin-left: auto; width: .5rem; height: .5rem; background: #3156c8; border-radius: .1rem; }
  .editor-style i + b { margin-left: 0; }
  .editor-canvas { position: relative; display: grid; align-content: center; padding: 2.7rem 1.25rem; background-color: #f0f3f9; background-image: radial-gradient(#cbd3e2 .7px, transparent .7px); background-size: 14px 14px; }
  .canvas-label { position: absolute; top: 1rem; left: 1rem; color: #626f87; font: .5rem var(--font-data); letter-spacing: .08em; }
  .guide-preview { position: relative; padding: 1.25rem; border: 1px solid #6b8ade; outline: 3px solid #dfe7ff; border-radius: .65rem; background: white; box-shadow: 0 8px 22px rgba(36, 48, 85, .1); }
  .selection-label { position: absolute; top: -1.25rem; left: -.05rem; padding: .1rem .4rem; border-radius: .2rem .2rem 0 0; background: #3156c8; color: white; font-size: .5rem; }
  .guide-preview > small { color: var(--primary); font-size: .52rem; letter-spacing: .06em; }
  .guide-preview > strong { display: block; margin-top: .55rem; font-size: 1.15rem; letter-spacing: -.035em; line-height: 1.2; }
  .guide-preview p { margin: .65rem 0 1.2rem; color: #656b76; font-size: .65rem; line-height: 1.65; }
  .guide-preview > div:not(.selection-label) { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: .5rem; font-size: .55rem; }
  .guide-preview div > b { padding: .5rem .65rem; border-radius: .35rem; background: #3156c8; color: white; font-weight: 500; }
  .selection-handle { position: absolute; right: -.2rem; bottom: -.2rem; width: .4rem; height: .4rem; border: 1px solid #3156c8; background: white; }
  .canvas-footer { position: absolute; inset: auto .8rem .7rem; display: flex; justify-content: space-between; font-size: .5rem; color: #626f87; }
  .rule-group { padding: .8rem; border: 1px solid #e0e5ef; border-radius: .55rem; background: #fbfcfe; }
  .rule-group p { margin: 0 0 .7rem; color: #5c667b; font-size: .65rem; }
  .rule-group p b { padding: .15rem .35rem; border: 1px solid #dce3f4; border-radius: .25rem; background: #edf2ff; color: #3156c8; font: 600 .6rem var(--font-data); }
  .rule-line { display: grid; grid-template-columns: 3.4rem minmax(0, 1fr) auto; align-items: center; gap: .4rem; padding: .65rem .5rem; border: 1px solid #e6e8ee; border-radius: .35rem; background: white; }
  .rule-line + .rule-line { margin-top: .4rem; }
  .rule-line > span { color: #566b99; font-size: .55rem; }
  .rule-line > b { min-width: 0; overflow-wrap: anywhere; font-size: .62rem; font-weight: 500; }
  .rule-line small { color: #656b76; font-size: .55rem; }
  .nested-rules { margin-top: .7rem; padding: .6rem 0 0 .6rem; border-left: 2px solid #bccbed; }
  .delivery-context { display: flex; align-items: center; gap: .65rem; margin-top: .8rem; padding: .8rem; border-radius: .45rem; background: #eef3ff; color: #3156c8; }
  .delivery-context > svg { flex-shrink: 0; }
  .delivery-context > svg:last-child { margin-left: auto; }
  .delivery-context > span { display: grid; gap: .2rem; }
  .delivery-context strong { font-size: .65rem; }
  .delivery-context small { color: #54658a; font-size: .53rem; line-height: 1.5; }
  .result-metrics { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .5rem; margin: 0 0 1rem; }
  .result-metrics > div { padding: .85rem .65rem; border: 1px solid #e2e6ee; border-radius: .45rem; }
  .result-metrics > div:last-child { background: #f0f4ff; border-color: #d6e0fa; }
  .result-metrics dt { color: #626b7d; font-size: .59rem; }
  .result-metrics dd { margin: .3rem 0 0; font-size: 1.5rem; font-weight: 600; letter-spacing: -.05em; font-variant-numeric: tabular-nums; }
  .result-metrics dd span { font-size: .9rem; }
  .result-funnel { padding: 1rem .85rem; border: 1px solid #e2e6ee; border-radius: .5rem; }
  .results-panel-heading { display: flex; justify-content: space-between; gap: .5rem; margin-bottom: .9rem; font-size: .65rem; }
  .results-panel-heading > span { color: #656b76; font-size: .56rem; }
  .result-step { display: grid; grid-template-columns: 1rem 6rem minmax(0, 1fr) 1.6rem; align-items: center; gap: .5rem; padding-block: .65rem; font-size: .58rem; }
  .result-step > span { color: #656b76; font: .5rem var(--font-data); }
  .result-step > b { font-weight: 400; }
  .result-step > strong { text-align: right; font-variant-numeric: tabular-nums; }
  .result-bar { height: .6rem; border-radius: .2rem; background: #eef1f6; }
  .result-bar i { display: block; height: 100%; border-radius: inherit; background: var(--primary); }
  .results-insight { display: flex; align-items: flex-start; gap: .6rem; margin-top: .8rem; padding: .85rem; border-radius: .5rem; background: #f7f8fa; }
  .results-insight > svg { flex-shrink: 0; margin-top: .1rem; color: #536a9d; }
  .results-insight strong { font-size: .65rem; }
  .results-insight p { margin: .3rem 0 0; color: #626b7d; font-size: .61rem; line-height: 1.6; }
  @media (max-width: 900px) {
    .capability-row, .capability-row.is-reverse { grid-template-columns: minmax(0, 1fr); gap: 2rem; }
    .is-reverse .capability-copy { order: initial; }
    .capability-copy { max-width: 38rem; }
    .capability-copy h3 { max-width: 32rem; }
    .capability-figure { width: min(100%, 38rem); }
  }
  @media (max-width: 480px) {
    .capabilities-intro h2 br { display: none; }
    .mockup-toolbar { padding-inline: .7rem; gap: .45rem; }
    .mockup-tag { font-size: .52rem; }
    .editor-workspace { grid-template-columns: 6.2rem minmax(0, 1fr); }
    .editor-sidebar { padding: .5rem; }
    .editor-tabs { font-size: .5rem; }
    .editor-canvas { padding-inline: .75rem; }
    .guide-preview { padding: .85rem; }
    .guide-preview > strong { font-size: 1rem; }
    .rule-line { grid-template-columns: 2.6rem minmax(0, 1fr); }
    .rule-line small { grid-column: 2; }
    .rule-line > b { font-size: .61rem; }
    .result-step { grid-template-columns: .8rem 5.25rem minmax(0, 1fr) 1.5rem; gap: .35rem; }
    .result-metrics > div { padding-inline: .5rem; }
    .result-metrics dt { font-size: .54rem; }
    .captured-events > div { flex-wrap: wrap; }
  }
</style>
