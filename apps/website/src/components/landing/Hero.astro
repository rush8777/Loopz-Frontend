---
import { DASHBOARD_URLS } from "../../config/site";
import { LinkButton } from "../react/LinkButton";
import ProductOverview from "../product/ProductOverview.astro";
---

<section class="hero-section" id="top">
  <div class="hero-copy" data-reveal>
    <h1>Turn user behavior<br />    into action.</h1>
    <div class="hero-bottom-row">
      <div class="hero-actions">
        <LinkButton href={DASHBOARD_URLS.signup} label="Get started free" size="lg" className="hero-primary" />
        <LinkButton href="#product" label="Explore the product" variant="outline" size="lg" className="hero-secondary" />
      </div>
      <p class="hero-description">
        Movcues shows where users struggle and helps you act with targeted in-app experiences that drive adoption and growth.

      </p>
    </div>
  </div>
  <div class="hero-product" id="product" data-reveal>
    <ProductOverview />
  </div>
</section>
