---
import ProductOverview from "../product/ProductOverview.astro";
---

<section class="hero-section" id="top">
  <div class="hero-copy" data-reveal>
    <h1>Turn user behavior<br />    into action.</h1>
    <div class="hero-bottom-row">
      <div class="hero-actions">
        <button class="hero-primary waitlist-trigger" type="button" data-waitlist-open>Join waitlist</button>
        <a href="#product" class="hero-secondary">Explore the product</a>
      </div>
      <p class="hero-description">
        Movcues shows where users struggle and helps you act with targeted in-app experiences that drive adoption and growth.

      </p>
    </div>
  </div>
  <div class="hero-product" id="product" data-reveal>
    <ProductOverview />
  </div>
</section>
