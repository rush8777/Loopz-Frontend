---
import ProductVisual from "./ProductVisual.astro";
interface Props { eyebrow: string; title: string; description: string; points?: string[]; visual: string; video?: string; reverse?: boolean; tone?: "light" | "soft" | "dark"; productCard?: boolean }
const { eyebrow, title, description, points = [], visual, video, reverse = false, tone = "light", productCard = false } = Astro.props;
---
<section class:list={["feature-split", `is-${tone}`, reverse && "is-reverse", productCard && "is-product-card"]} data-reveal>
  <div class="section-shell feature-split-grid">
    <div class="feature-split-copy"><p class="section-kicker"><span></span>{eyebrow}</p><h2>{title}</h2><p>{description}</p>{points.length > 0 && <ul>{points.map((point) => <li><span>✓</span>{point}</li>)}</ul>}</div>
    <div class="feature-split-visual"><ProductVisual variant={visual} video={video} /></div>
  </div>
</section>
