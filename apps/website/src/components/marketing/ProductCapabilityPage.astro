---
import { DASHBOARD_URLS } from "../../config/site";
import MarketingLayout from "./MarketingLayout.astro";

type Capability = "guide" | "modal" | "checklist" | "tooltip" | "dashboard";
interface Props { capability: Capability }
const { capability } = Astro.props;

const pages = {
  guide: {
    eyebrow: "Guides", title: "Guide the next useful action.",
    description: "Build multi-step guidance around the real page, then advance each step by a button, user action, event, or route.",
    label: "Guide builder", route: "/product/guide",
    features: [["A step pattern for the moment", "Use an anchored card when the UI element matters, or a modal step when it does not. Tune placement, alignment, offset, pointer, and layer behavior per step."], ["Progress from real behavior", "Advance with a button, element click, element hover, custom event, or route rule—so a guide can respond to what a person actually does."], ["Delivery is part of the build", "Start from page rules and an audience, then set page-load, custom-event, or manual triggers, frequency, priority, queueing, and schedule."]],
    featureDetails: [["Anchored card or modal", "Placement, alignment & offset", "Layer behaviour"], ["Button or element click", "Element hover", "Custom event or route"], ["Page & audience rules", "Trigger & frequency", "Priority, queue & schedule"]],
    proofNote: "A guide should follow a person's progress—not ask them to follow a script.",
    outcomes: ["Help users act in the right place instead of reading a detached walkthrough.", "Keep a multi-step experience relevant as a user navigates, clicks, or completes a product action.", "Use the same targeting controls that govern the rest of your in-app experiences."],
    workflow: ["Choose the page", "Build the steps", "Set delivery rules", "Review completion"],
  },
  modal: {
    eyebrow: "Modals", title: "Make an announcement impossible to miss.",
    description: "Design a focused modal inside your product and decide exactly who should see it, where, and when.",
    label: "Modal builder", route: "/product/modals",
    features: [["A controlled surface", "Choose a centered or fullscreen modal, configure its size, and control the backdrop, opacity, and backdrop-dismiss behavior."], ["Fit it into the page", "Keep the delivery layer automatic, place it relative to a target, keep it on top, or use a custom z-index when your app has competing UI."], ["Reach a specific moment", "Use page rules, segments or combined segment rules, triggers, scheduling, priority, and frequency limits before the modal is published."]],
    featureDetails: [["Centered or fullscreen", "Backdrop & opacity", "Backdrop-dismiss control"], ["Automatic layer", "Relative to a target", "Always-on-top or custom z-index"], ["Page & segment rules", "Trigger & schedule", "Frequency, priority & queue"]],
    proofNote: "When the moment matters, control the message and the interruption with equal care.",
    outcomes: ["Give launches, upgrades, and important changes a focused surface without making every visitor see the same message.", "Protect the surrounding product flow with frequency and interrupt controls.", "Keep campaign delivery connected to behavioral audiences—not a separate messaging list."],
    workflow: ["Write the message", "Choose its layout", "Match an audience", "Publish deliberately"],
  },
  checklist: {
    eyebrow: "Checklists", title: "Keep onboarding work visible.",
    description: "Create a persistent task companion that connects users to guides, destinations, and progress milestones.",
    label: "Checklist setup", route: "/product/checklists",
    features: [["Start with the right shape", "Choose Default, Minimal, Soft, or Compact, then set bottom-left or bottom-right placement, any-order or sequential tasks, and an expanded or collapsed first state."], ["Connect each task to action", "A checklist item can launch a published guide, navigate inside the product, open a URL, or simply record that it was clicked."], ["Complete from real milestones", "Mark work complete from the item click, a matching segment, or a completed guide. Progress is carried forward when an anonymous visitor becomes an identified user."],],
    featureDetails: [["Four visual presets", "Bottom-left or bottom-right", "Sequential or any-order tasks"], ["Launch a published guide", "Navigate or open a URL", "Record an item click"], ["Item click or segment", "Completed guide", "Anonymous progress is retained"]],
    proofNote: "Make momentum visible, then let real product behavior prove the progress.",
    outcomes: ["Turn a setup plan into visible, persistent progress instead of a one-time welcome message.", "Use product behavior and guide completion as proof of progress—not just a user saying they saw a task.", "Keep the next useful step available after the first session ends."],
    workflow: ["Pick a preset", "Add the tasks", "Define completion", "Target the checklist"],
  },
  tooltip: {
    eyebrow: "Tooltips", title: "Put help next to the work.",
    description: "Use anchored cards and hotspots for tooltip-style guidance that attaches to a reliable element in your product.",
    label: "Contextual help", route: "/product/tooltips",
    features: [["Two contextual patterns", "Use an anchored card for a short explanation beside the interface, or a hotspot to make a feature discoverable without opening a message immediately."], ["Placement with intent", "Set placement, alignment, offset, pointer, layer, and dismiss behavior so the guidance works with your product UI rather than against it."], ["More durable targets", "Movcues retains a primary selector, up to five fallback selectors, and a reliability signal for each captured target before you publish."]],
    featureDetails: [["Anchored card", "Hotspot", "Guidance beside the UI"], ["Placement & alignment", "Offset & pointer", "Layer & dismiss behaviour"], ["Primary selector", "Up to five fallbacks", "Reliability signal"]],
    proofNote: "The most useful explanation is the one that appears exactly where the question does.",
    outcomes: ["Explain a control where it is used, reducing the distance between a question and the answer.", "Make help available without interrupting the person’s current task.", "Review target reliability before a small UI change turns into misplaced guidance."],
    workflow: ["Select an element", "Choose the pattern", "Tune the placement", "Publish to the right audience"],
  },
  dashboard: {
    eyebrow: "Dashboards", title: "Keep the evidence in view.",
    description: "Assemble reusable dashboards from metrics, funnels, retention, and experience performance—then filter the view without rebuilding it.",
    label: "Dashboard workspace", route: "/product/dashboards",
    features: [["One workspace, four analysis types", "Combine Metric, Funnel, Retention, and Experience cards in a saved dashboard. Experience cards can report reach, completions, dismissals, responses, and interaction metrics."], ["Shape the view around the question", "Choose small, medium, or full-width cards, order them deliberately, and use supported visualizations that fit each analysis type."], ["Filter, then investigate", "Apply a date range, day/week/month granularity, segment, and excluded events across the dashboard. Metric, funnel, and retention results support raw-result drilldowns."]],
    featureDetails: [["Metric & Funnel", "Retention & Experience", "Reach, completion & interaction"], ["Small, medium or full width", "Card ordering", "Type-appropriate visualizations"], ["Date & granularity", "Segment & excluded events", "Supported raw-result drilldowns"]],
    proofNote: "Keep the signal close: the next decision should not require a new report.",
    outcomes: ["Keep adoption, behavior, and experience performance together instead of assembling a one-off report each time.", "Give teams a reusable view of the same definitions and filters.", "Move from a trend or funnel to the underlying users or sessions when the analysis supports it."],
    workflow: ["Name the dashboard", "Add analysis cards", "Set the filters", "Drill into results"],
  },
} as const;

const page = pages[capability];
---

<MarketingLayout title={`${page.eyebrow} | Movcues`} description={page.description} canonicalPath={page.route}>
  <section class:list={["capability-hero", `is-${capability}`]}>
    <div class="capability-shell">
      <div class="capability-copy" data-reveal>
        <p class="capability-eyebrow"><span></span>{page.eyebrow}</p>
        <h1>{page.title}</h1>
        <p>{page.description}</p>
        <div class="capability-actions"><a href={DASHBOARD_URLS.signup}>Get started free</a><a href="#capabilities">See capabilities <span>↓</span></a></div>
      </div>
      <div class="capability-demo" aria-label={`${page.label} preview`} data-reveal>
        {capability === "guide" && <div class="demo-guide"><div class="demo-toolbar"><i></i><span>Setup flow</span><small>Step 2 of 4</small></div><div class="demo-stage"><div class="demo-highlight"></div><div class="demo-guide-card"><b>Invite teammates</b><p>Bring the right people into this workspace.</p><div><span>Back</span><strong>Continue</strong></div></div></div><div class="demo-steps"><span></span><span class="is-active"></span><span></span><span></span></div></div>}
        {capability === "modal" && <div class="demo-modal"><div class="demo-appbar"><i></i><span>workspace.movcues</span></div><div class="demo-backdrop"><article><small>NEW IN YOUR WORKSPACE</small><b>Make a better first impression.</b><p>Set up your welcome experience in a few focused steps.</p><div><button>Not now</button><strong>Set it up</strong></div></article></div></div>}
        {capability === "checklist" && <div class="demo-checklist"><div class="demo-appbar"><i></i><span>Workspace home</span></div><article><header><div><small>ONBOARDING</small><b>Set up your workspace</b></div><strong>2 / 4</strong></header><div class="demo-progress"><i></i></div><ul><li class="is-done"><span>✓</span> Invite a teammate</li><li class="is-done"><span>✓</span> Create your first segment</li><li><span></span> Build a welcome guide</li><li><span></span> Review engagement</li></ul><footer>Keep going <span>→</span></footer></article></div>}
        {capability === "tooltip" && <div class="demo-tooltip"><div class="demo-appbar"><i></i><span>Page editor</span></div><div class="demo-ui"><span class="demo-nav"></span><span class="demo-button">Publish</span><i class="demo-hotspot">?</i><article><small>CONTEXTUAL HELP</small><b>Ready when you are.</b><p>Use this button when the experience is ready to go live.</p><span></span></article></div></div>}
        {capability === "dashboard" && <div class="demo-dashboard"><div class="demo-appbar"><i></i><span>Activation health</span><button>Last 30 days</button></div><div class="demo-metric-row"><article><small>ACTIVE USERS</small><b>12,480</b><em>+12.4%</em></article><article><small>ACTIVATION RATE</small><b>42.8%</b><em>+4.2%</em></article><article><small>GUIDE COMPLETION</small><b>68.1%</b><em>+8.1%</em></article></div><div class="demo-chart"><div><span></span><span></span><span></span><span></span><span></span><span></span><span></span></div><p>Activation trend <b>↗</b></p></div></div>}
      </div>
    </div>
  </section>

  <section class="capability-proof" id="capabilities">
    <div class="capability-shell"><p>Built around what Movcues actually supports</p><div>{page.features.map(([title, description], index) => <article data-reveal><span>0{index + 1}</span><h2>{title}</h2><p>{description}</p><details><summary>Explore the controls <b>+</b></summary><ul>{page.featureDetails[index].map((detail) => <li><i></i>{detail}</li>)}</ul></details></article>)}</div><blockquote>“{page.proofNote}”</blockquote></div>
  </section>

  <section class="capability-outcomes">
    <div class="capability-shell"><div><p class="capability-eyebrow"><span></span>Why it matters</p><h2>{page.eyebrow} that stay connected to product behavior.</h2></div><ul>{page.outcomes.map((outcome) => <li><span>✦</span>{outcome}</li>)}</ul></div>
  </section>

  <section class="capability-workflow">
    <div class="capability-shell"><div><p class="capability-eyebrow"><span></span>From setup to signal</p><h2>A focused workflow, not a generic blast.</h2></div><ol>{page.workflow.map((step, index) => <li><span>0{index + 1}</span><b>{step}</b></li>)}</ol></div>
  </section>

  <section class="capability-cta"><div class="capability-shell"><p>{page.eyebrow}</p><h2>Build the next useful moment.</h2><a href={DASHBOARD_URLS.signup}>Create your workspace <span>→</span></a></div></section>
</MarketingLayout>

<style>
  .capability-hero { overflow: hidden; padding: clamp(4.7rem, 8vw, 7.5rem) 0 clamp(4rem, 7vw, 6rem); background: #111315; color: #f7f4eb; }
  .capability-shell { width: min(1160px, calc(100% - (var(--site-gutter) * 2))); margin: 0 auto; }
  .capability-hero .capability-shell { display: grid; grid-template-columns: minmax(0, .88fr) minmax(24rem, 1.12fr); align-items: center; gap: clamp(2.5rem, 7vw, 7rem); }
  .capability-eyebrow { margin: 0; display: flex; align-items: center; gap: .55rem; color: #c8ff73; font-size: .69rem; font-weight: 700; letter-spacing: .13em; text-transform: uppercase; }
  .capability-eyebrow span { width: 1.55rem; height: 1px; background: currentColor; }
  .capability-copy h1 { max-width: 9ch; margin: 1.15rem 0 0; font-size: clamp(3.1rem, 5.2vw, 5.8rem); font-weight: 500; letter-spacing: -.075em; line-height: .91; text-wrap: balance; }
  .capability-copy > p:not(.capability-eyebrow) { max-width: 31rem; margin: 1.45rem 0 0; color: #c6c8c6; font-size: 1.02rem; line-height: 1.7; }
  .capability-actions { margin-top: 2rem; display: flex; flex-wrap: wrap; gap: .75rem; }
  .capability-actions a { min-height: 3rem; padding: .75rem 1.05rem; display: inline-flex; align-items: center; gap: .5rem; border-radius: .5rem; color: #121413; font-size: .82rem; font-weight: 700; text-decoration: none; background: #c8ff73; }
  .capability-actions a + a { border: 1px solid #464a47; color: #f7f4eb; background: transparent; }
  .capability-demo { position: relative; min-height: 25rem; border: 1px solid #3d413f; border-radius: 1.1rem; overflow: hidden; background: #e9ece6; color: #1b201c; box-shadow: 1.25rem 1.25rem 0 #c8ff73; }
  .demo-appbar, .demo-toolbar { height: 3rem; padding: 0 .9rem; display: flex; align-items: center; gap: .55rem; border-bottom: 1px solid #d7dbd4; background: #fbfcfa; color: #626862; font-size: .65rem; }
  .demo-appbar i, .demo-toolbar i { width: 1.2rem; height: 1.2rem; border-radius: .32rem; background: #202823; } .demo-appbar button { margin-left: auto; border: 1px solid #d6dad5; border-radius: .35rem; background: #fff; color: #626862; font-size: .55rem; padding: .38rem .5rem; }
  .demo-toolbar small { margin-left: auto; font-weight: 700; color: #687060; }
  .demo-stage { position: relative; min-height: 20.2rem; background: linear-gradient(135deg, #dfe4dd, #f8f9f6); }.demo-highlight { position: absolute; left: 16%; top: 18%; width: 40%; height: 2.8rem; border: 2px solid #bcfa52; border-radius: .45rem; box-shadow: 0 0 0 900px rgba(17, 19, 18, .25); }.demo-guide-card { position: absolute; right: 7%; bottom: 11%; width: 15.5rem; padding: 1rem; border: 1px solid #cdd3cc; border-radius: .65rem; background: #fff; box-shadow: 0 1rem 2rem rgba(23,30,24,.13); }.demo-guide-card b, .demo-modal article b, .demo-tooltip article b { display: block; font-size: 1rem; }.demo-guide-card p, .demo-modal article p, .demo-tooltip article p { margin: .45rem 0 .8rem; color: #6a706b; font-size: .65rem; line-height: 1.5; }.demo-guide-card div, .demo-modal article div { display: flex; justify-content: flex-end; gap: .5rem; font-size: .6rem; align-items: center; }.demo-guide-card strong, .demo-modal article strong { padding: .45rem .6rem; border-radius: .3rem; background: #202823; color: #fff; }.demo-steps { padding: .55rem .9rem; display: flex; gap: .35rem; background: #fff; }.demo-steps span { width: 1.25rem; height: .28rem; border-radius: 1rem; background: #d9ddd8; }.demo-steps .is-active { background: #9bd83b; }
  .demo-modal { height: 100%; background: #e9ece6; }.demo-backdrop { min-height: 22rem; padding: 2rem; display: grid; place-items: center; background: rgba(20,26,22,.65); }.demo-modal article { width: min(23rem, 100%); padding: 2rem; border-radius: .75rem; text-align: center; background: #fff; box-shadow: 0 1.4rem 3rem rgba(0,0,0,.22); }.demo-modal article small, .demo-tooltip article small { color: #5d8c15; font-size: .5rem; font-weight: 800; letter-spacing: .1em; }.demo-modal article b { margin-top: .7rem; font-size: 1.45rem; letter-spacing: -.04em; }.demo-modal article div { justify-content: center; }.demo-modal button { border: 0; background: transparent; color: #737973; font-size: .6rem; }
  .demo-checklist { height: 100%; background: #f4f6f2; }.demo-checklist article { width: min(21rem, 88%); margin: 2.2rem auto; padding: 1.15rem; border: 1px solid #d2d7d1; border-radius: .7rem; background: #fff; box-shadow: 0 1rem 2rem rgba(23,30,24,.08); }.demo-checklist header { display: flex; justify-content: space-between; align-items: start; }.demo-checklist small { display: block; color: #757c75; font-size: .5rem; letter-spacing: .08em; }.demo-checklist b { margin-top: .25rem; display: block; font-size: .95rem; }.demo-checklist header > strong { padding: .35rem .45rem; border-radius: .3rem; background: #ebf9d5; color: #547819; font-size: .58rem; }.demo-progress { height: .35rem; margin: 1rem 0; overflow: hidden; border-radius: 1rem; background: #edf0eb; }.demo-progress i { width: 50%; height: 100%; display: block; background: #a6dd46; }.demo-checklist ul { margin: 0; padding: 0; list-style: none; }.demo-checklist li { padding: .65rem 0; display: flex; align-items: center; gap: .6rem; border-top: 1px solid #edf0eb; font-size: .66rem; }.demo-checklist li span { width: 1rem; height: 1rem; display: grid; place-items: center; border: 1px solid #cbd1ca; border-radius: 50%; font-size: .55rem; }.demo-checklist li.is-done span { border-color: #9acb3e; background: #a6dd46; }.demo-checklist footer { margin-top: .7rem; padding: .65rem .75rem; display: flex; justify-content: space-between; border-radius: .35rem; background: #202823; color: #fff; font-size: .6rem; }
  .demo-tooltip { height: 100%; background: #f4f6f2; }.demo-ui { position: relative; min-height: 22rem; padding: 2rem; }.demo-nav { width: 6rem; height: 13rem; display: block; border-radius: .5rem; background: #e1e6df; }.demo-button { position: absolute; top: 25%; right: 15%; padding: .65rem .8rem; border-radius: .35rem; background: #202823; color: #fff; font-size: .58rem; }.demo-hotspot { position: absolute; top: 22%; right: 10%; width: 1.25rem; height: 1.25rem; display: grid; place-items: center; border: 3px solid #eafea9; border-radius: 50%; background: #8abd2c; color: #1d2a14; font-size: .55rem; font-style: normal; box-shadow: 0 0 0 .35rem rgba(154,203,62,.25); }.demo-tooltip article { position: absolute; right: 5%; bottom: 10%; width: 15rem; padding: .9rem; border: 1px solid #cbd2ca; border-radius: .5rem; background: #fff; box-shadow: 0 1rem 2rem rgba(23,30,24,.11); }.demo-tooltip article b { margin-top: .45rem; }.demo-tooltip article > span { position: absolute; top: -7px; right: 1.6rem; width: 12px; height: 12px; border-top: 1px solid #cbd2ca; border-left: 1px solid #cbd2ca; background: #fff; transform: rotate(45deg); }
  .demo-dashboard { height: 100%; padding-bottom: 1.1rem; background: #f4f6f2; }.demo-dashboard .demo-appbar { background: #fff; }.demo-metric-row { padding: 1rem; display: grid; grid-template-columns: repeat(3, 1fr); gap: .55rem; }.demo-metric-row article, .demo-chart { padding: .75rem; border: 1px solid #d6dbd5; border-radius: .45rem; background: #fff; }.demo-metric-row small { color: #777e77; font-size: .45rem; letter-spacing: .07em; }.demo-metric-row b { margin-top: .35rem; display: block; font-size: 1rem; }.demo-metric-row em { color: #6a9a1b; font-size: .52rem; font-style: normal; }.demo-chart { margin: 0 1rem; min-height: 12.7rem; }.demo-chart > div { height: 9rem; padding: 1rem 0 0; display: flex; align-items: end; gap: .55rem; border-bottom: 1px solid #dce1db; }.demo-chart span { width: 100%; border-radius: .2rem .2rem 0 0; background: #c8ff73; }.demo-chart span:nth-child(1){height:35%}.demo-chart span:nth-child(2){height:52%}.demo-chart span:nth-child(3){height:43%}.demo-chart span:nth-child(4){height:68%}.demo-chart span:nth-child(5){height:62%}.demo-chart span:nth-child(6){height:85%}.demo-chart span:nth-child(7){height:78%}.demo-chart p { margin: .7rem 0 0; color: #686f69; font-size: .6rem; }.demo-chart p b { float: right; color: #699517; }
  .capability-proof { padding: clamp(4.5rem, 8vw, 7.5rem) 0; background: #f6f3eb; }.capability-proof > div > p { margin: 0 0 2rem; color: #69706a; font-size: .72rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }.capability-proof > div > div { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid #d6d1c4; }.capability-proof article { min-height: 17rem; padding: 1.3rem; border-right: 1px solid #d6d1c4; border-bottom: 1px solid #d6d1c4; }.capability-proof article:first-child { border-left: 1px solid #d6d1c4; }.capability-proof article > span { color: #758a39; font-family: var(--font-data); font-size: .65rem; }.capability-proof h2 { max-width: 12rem; margin: 4rem 0 .8rem; color: #1e241f; font-size: clamp(1.35rem, 2vw, 1.75rem); font-weight: 500; letter-spacing: -.055em; line-height: 1; }.capability-proof article p { max-width: 17rem; margin: 0; color: #626962; font-size: .8rem; line-height: 1.6; }.capability-proof details { margin-top: 1.25rem; border-top: 1px solid #d6d1c4; }.capability-proof summary { padding-top: .8rem; display: flex; justify-content: space-between; align-items: center; cursor: pointer; color: #33402b; font-size: .68rem; font-weight: 700; letter-spacing: .025em; list-style: none; }.capability-proof summary::-webkit-details-marker { display: none; }.capability-proof summary b { width: 1.2rem; height: 1.2rem; display: grid; place-items: center; border: 1px solid #b4bdac; border-radius: 50%; font-size: .95rem; font-weight: 400; line-height: 1; transition: transform .2s ease, background .2s ease; }.capability-proof details[open] summary b { background: #c8ff73; border-color: #9bc94a; transform: rotate(45deg); }.capability-proof details ul { margin: .75rem 0 0; padding: 0; list-style: none; }.capability-proof details li { padding: .38rem 0; display: flex; align-items: center; gap: .5rem; color: #69706a; font-size: .67rem; line-height: 1.35; }.capability-proof details li i { width: .35rem; height: .35rem; flex: 0 0 auto; border-radius: 50%; background: #a6dd46; }.capability-proof blockquote { max-width: 42rem; margin: clamp(2.2rem, 5vw, 4rem) auto 0; padding: 1.15rem 1.35rem; border-left: 3px solid #9ed344; color: #485145; font-size: clamp(1.05rem, 1.8vw, 1.45rem); font-style: italic; letter-spacing: -.025em; line-height: 1.3; text-align: center; }
  .capability-outcomes { padding: clamp(4.5rem, 7vw, 6.5rem) 0; background: #fff; color: #1e241f; }.capability-outcomes .capability-shell { display: grid; grid-template-columns: .85fr 1.15fr; gap: clamp(2.5rem, 7vw, 8rem); align-items: start; }.capability-outcomes .capability-eyebrow { margin: 0; color: #617d28; font-size: .7rem; font-weight: 700; letter-spacing: .11em; text-transform: uppercase; }.capability-outcomes .capability-eyebrow span { width: .5rem; height: .5rem; margin-right: .45rem; display: inline-block; border-radius: 50%; background: #a6dd46; }.capability-outcomes h2 { max-width: 11ch; margin: 1rem 0 0; font-size: clamp(2.1rem, 4vw, 4rem); font-weight: 500; letter-spacing: -.065em; line-height: .94; }.capability-outcomes ul { margin: 0; padding: 0; list-style: none; border-top: 1px solid #dbe0d8; }.capability-outcomes li { padding: 1.15rem 0; display: grid; grid-template-columns: 1.6rem 1fr; gap: .7rem; border-bottom: 1px solid #dbe0d8; color: #4e574e; font-size: .92rem; line-height: 1.55; }.capability-outcomes li span { color: #78a82a; font-size: .85rem; }
  .capability-workflow { padding: clamp(4.5rem, 7vw, 6.5rem) 0; background: #d2ff83; color: #172016; }.capability-workflow .capability-shell { display: grid; grid-template-columns: .75fr 1.25fr; gap: 4rem; }.capability-workflow .capability-eyebrow { color: #3c5c17; }.capability-workflow h2 { max-width: 13ch; margin: 1.1rem 0 0; font-size: clamp(2.2rem, 4vw, 4.4rem); font-weight: 500; letter-spacing: -.065em; line-height: .93; }.capability-workflow ol { margin: 0; padding: 0; list-style: none; }.capability-workflow li { min-height: 4.5rem; padding: 1rem 0; display: flex; align-items: center; gap: 1rem; border-top: 1px solid rgba(25,39,21,.2); }.capability-workflow li:last-child { border-bottom: 1px solid rgba(25,39,21,.2); }.capability-workflow li span { color: #567d1d; font-family: var(--font-data); font-size: .65rem; }.capability-workflow li b { font-size: 1rem; font-weight: 600; }
