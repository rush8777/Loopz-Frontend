---
const preview = process.env.CF_PAGES_BRANCH && process.env.CF_PAGES_BRANCH !== 'main';
const origin = preview
  ? (process.env.CF_PAGES_URL || 'https://preview-hero-story-demo.movcues.pages.dev')
  : (Astro.site?.origin || 'https://movcues.com');
const videoSchema = {
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  name: 'Movcues: turn user behavior into action',
  description: 'A 20-second motion graphics film showing how Movcues helps teams understand behavior, find users who need help, deliver contextual guidance, and evaluate what happens next.',
  thumbnailUrl: new URL('/videos/hero/movcues-hero-poster.webp', origin).href,
  contentUrl: new URL('/videos/hero/movcues-hero-web.mp4', origin).href,
  uploadDate: '2026-10-10T00:00:00Z',
  duration: 'PT20S',
  inLanguage: 'en',
  publisher: { '@type': 'Organization', name: 'Movcues', url: 'https://movcues.com' },
};
---

<script type="application/ld+json" set:html={JSON.stringify(videoSchema).replace(/</g, '\\u003c')} />
<div class="hero-film" data-hero-film>
  <div class="film-stage">
    <picture class="film-poster">
      <source media="(max-width: 700px)" srcset="/videos/hero/movcues-hero-mobile.webp" width="960" height="720" />
      <img src="/videos/hero/movcues-hero-poster.webp" width="1280" height="720" loading="lazy" decoding="async" alt="Movcues turns user behavior into action: understand, target, guide and improve." />
    </picture>
    <video class="film-video" width="1280" height="720" autoplay muted playsinline loop preload="none" poster="/videos/hero/movcues-hero-poster.webp" data-src="/videos/hero/movcues-hero-web.mp4" aria-label="Turn user behavior into action: a 20-second Movcues motion graphics film" aria-describedby="hero-film-caption">
      Your browser cannot play this video. The still image and description explain the product workflow.
    </video>
  </div>
  <div class="film-controls">
    <span data-film-status>Movcues film · 20 seconds</span>
    <button type="button" data-film-toggle hidden>Pause video</button>
  </div>
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-hero-film]')) {
    const video = root.querySelector<HTMLVideoElement>('video')!;
    const button = root.querySelector<HTMLButtonElement>('[data-film-toggle]')!;
    const status = root.querySelector<HTMLElement>('[data-film-status]')!;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    const mobile = matchMedia('(max-width: 700px)');
    let inView = false;
    let userPaused = false;
    let failed = false;
    const staticView = () => reduced.matches || mobile.matches;
    const label = () => { button.textContent = userPaused ? 'Play video' : 'Pause video'; };
    const showPoster = () => root.classList.remove('is-video-ready');
    const play = async () => {
      try {
        await video.play();
        if (!staticView() && !failed && !userPaused && inView && !document.hidden) {
          root.classList.add('is-video-ready'); button.hidden = false; label();
        } else video.pause();
      } catch (error) {
        if (error instanceof DOMException && error.name === 'AbortError') return;
        if (failed) { showPoster(); button.hidden = true; return; }
        showPoster(); button.hidden = staticView(); button.textContent = 'Play video'; userPaused = true;
        status.textContent = 'Movcues film · Select play, or view the still image';
      }
    };
    const sync = () => {
      if (staticView()) {
        video.pause(); showPoster(); button.hidden = true;
        if (video.hasAttribute('src')) { video.removeAttribute('src'); video.load(); }
        status.textContent = 'Movcues film · Static preview';
        return;
      }
      if (failed) return;
      status.textContent = 'Movcues film · 20 seconds';
      if (!inView || document.hidden || userPaused) { video.pause(); return; }
      if (!video.hasAttribute('src')) video.src = video.dataset.src!;
      video.muted = true;
      void play();
    };
    button.addEventListener('click', () => { userPaused = !userPaused; label(); sync(); });
    video.addEventListener('error', () => {
      if (!video.hasAttribute('src')) return;
      failed = true; video.pause(); showPoster(); button.hidden = true;
      status.textContent = 'Movcues film · Showing a still preview';
    });
    const observer = new IntersectionObserver(entries => { inView = entries[0].intersectionRatio >= .15; sync(); }, { threshold: [0, .15] });
    observer.observe(root);
    reduced.addEventListener('change', sync);
    mobile.addEventListener('change', sync);
    document.addEventListener('visibilitychange', sync);
    sync();
  }
</script>

<style>
  .hero-film { width: 100%; }
  .film-stage { position: relative; width: 100%; aspect-ratio: 16 / 9; border: 1px solid #dce2ed; border-radius: 14px; background: #f7f8fb; overflow: hidden; box-shadow: 0 18px 50px #2020200d; }
  .film-poster, .film-poster img, .film-video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; display: block; }
  .film-video { opacity: 0; pointer-events: none; }
  .is-video-ready .film-video { opacity: 1; }
  .film-controls { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 12px 2px 0; min-height: 41px; font-size: 11px; color: #65738c; }
  .film-controls button { padding: 6px 11px; border: 1px solid #dce2ed; border-radius: 6px; color: #3156c8; background: white; cursor: pointer; font: inherit; white-space: nowrap; }
  .film-controls button[hidden] { display: none; }
  .film-controls button:hover { background: #eef2ff; }
  .film-controls button:focus-visible { outline: 3px solid #3156c8; outline-offset: 3px; }
  @media (max-width: 700px) { .film-stage { aspect-ratio: 4 / 3; } .film-video { display: none; } .film-controls { font-size: 10px; } }
  @media (prefers-reduced-motion: reduce) { .film-video { display: none; } }
</style>
