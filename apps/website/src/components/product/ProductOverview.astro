<div class="overview-stage">
  <div class="overview-glow overview-glow-one"></div>
  <div class="overview-glow overview-glow-two"></div>
  <div class="product-window overview-window">
    <img
      class="hero-card-image hero-video-poster"
      src="/images/hero-card-img.png"
      alt="Movcues product experience dashboard with guides, surveys, and analytics"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      data-deferred-hero-video
      data-video-src="/videos/movcues-hero-video.mp4"
    />
  </div>
</div>

<script>
  // Keep the hero poster as the initial (and mobile) product preview.
  // A high-resolution video should not compete with mobile LCP or replace its image.
  const poster = document.querySelector<HTMLImageElement>("[data-deferred-hero-video]");
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const narrowScreen = window.matchMedia("(max-width: 767px)");

  if (poster && !reducedMotion.matches && !narrowScreen.matches && "IntersectionObserver" in window) {
    let mounted = false;
    const mountVideo = () => {
      if (mounted || document.hidden || narrowScreen.matches || reducedMotion.matches) return;
      const src = poster.dataset.videoSrc;
      const host = poster.parentElement;
      if (!src || !host) return;
      mounted = true;

      const video = document.createElement("video");
      video.className = "hero-card-video";
      video.src = src;
      video.poster = poster.currentSrc || poster.src;
      video.muted = true;
      video.autoplay = true;
      video.loop = true;
      video.playsInline = true;
      video.preload = "metadata";
      video.setAttribute("aria-hidden", "true");
      host.appendChild(video);

      video.addEventListener("loadeddata", () => {
        void video.play().then(() => {
          video.classList.add("is-playing");
        }).catch(() => {
          video.remove(); // The accessible poster never disappears.
          mounted = false;
        });
      }, { once: true });
      video.load();
    };
    const deferVideo = () => {
      // Allow the image to paint and remain the LCP candidate before video transfer.
      window.setTimeout(mountVideo, 2600);
    };
    const observer = new IntersectionObserver((entries) => {
      if (!entries.some((entry) => entry.isIntersecting)) return;
      observer.disconnect();
      if (document.readyState === "complete") deferVideo();
      else window.addEventListener("load", deferVideo, { once: true });
    }, { threshold: .1 });
    observer.observe(poster);
    document.addEventListener("visibilitychange", () => {
      if (!document.hidden && !mounted && document.readyState === "complete") deferVideo();
    });
  }
</script>
