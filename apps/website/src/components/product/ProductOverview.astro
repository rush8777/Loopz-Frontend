  .story-caption strong { display: block; color: #273652; font-size: 15px; font-weight: 550; margin-bottom: 4px; }
  .story-caption a { color: #3156c8; text-decoration: underline; text-underline-offset: 3px; }
  .story-transcript { max-width: 730px; margin: 14px auto 4px; color: #65738c; font-size: 12px; line-height: 1.7; }
  .story-transcript summary { width: fit-content; margin: auto; color: #3156c8; cursor: pointer; }
  .story-transcript summary:focus-visible { outline: 2px solid #3156c8; outline-offset: 4px; }
